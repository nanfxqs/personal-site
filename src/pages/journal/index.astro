---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  compareJournalPosts,
  formatJournalDate,
  formatJournalDateTimeAttr,
} from '@/lib/journal-date';
import { normalizeJournalSlug } from '@/lib/kb-graph';

const posts = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  compareJournalPosts,
);
---

<BaseLayout title="个人日常">
  <header class="border-b border-[var(--border)] py-12">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <div>
        <h1 class="font-editorial text-3xl font-semibold text-[var(--text)] sm:text-4xl">
          个人日常与随笔
        </h1>
        <p class="mt-2 text-sm text-[var(--text-muted)]">
          记录生活片段、随笔感慨、图像与影音。共 {posts.length} 篇。
        </p>
      </div>
      <span class="hidden text-xs font-mono text-[var(--text-muted)] sm:inline">
        支持鼠标上下拖拽或滚轮浏览
      </span>
    </div>
  </header>

  <!-- Vertical Draggable & Fading Timeline (natural page scroll on mobile, fading viewport on md+) -->
  <section class="py-8">
    <div
      id="vertical-timeline-viewport"
      class="no-scrollbar relative px-1 py-4 sm:px-2 md:timeline-fade-mask md:max-h-[72vh] md:overflow-y-auto md:py-10 md:select-none md:cursor-grab"
    >
      <div class="relative mx-auto max-w-3xl border-l border-border pl-7 sm:pl-10">
        {
          posts.map((post) => {
            const slug = normalizeJournalSlug(post.id);
            const dateStr = formatJournalDate(post.data.date, post.data.datePrecision, post.data.dateLabel);
            const dateTimeAttr = formatJournalDateTimeAttr(
              post.data.date,
              post.data.datePrecision,
            );
            return (
              <article
                data-timeline-item
                class="relative"
              >
                <a
                  href={`/journal/${slug}`}
                  draggable="false"
                  class="journal-entry relative block rounded-sm py-5 pr-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary sm:py-6"
                >
                  <span aria-hidden="true" class="journal-node absolute -left-7 top-[1.75rem] size-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full border border-primary bg-background sm:-left-10 sm:top-[2rem]" />
                  <div class="journal-copy">
                    <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                      <span class="tabular-nums tracking-wide">
                        {dateTimeAttr ? <time datetime={dateTimeAttr}>{dateStr}</time> : dateStr}
                      </span>
                      {post.data.mood && <span>{post.data.mood}</span>}
                      {post.data.media.length > 0 && <span>含 {post.data.media.length} 个媒体附件</span>}
                      {post.data.tags.map((tag) => (
                        <span class="text-[11px] text-muted-foreground">#{tag}</span>
                      ))}
                    </div>

                    <h2 class="journal-title mt-1.5 font-editorial text-xl font-semibold text-foreground sm:text-2xl">
                      {post.data.title}
                    </h2>

                    {post.data.summary && (
                      <p class="mt-2 font-editorial text-sm leading-relaxed text-muted-foreground">
                        {post.data.summary}
                      </p>
                    )}
                  </div>
                </a>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .journal-title {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
  }

  .journal-entry:focus-visible .journal-title {
    text-decoration-color: var(--primary);
  }

  .journal-entry:focus-visible .journal-node {
    background-color: var(--primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .journal-entry:hover .journal-title { text-decoration-color: var(--primary); }
    .journal-entry:hover .journal-node { background-color: var(--primary); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .journal-copy, .journal-node {
      transition: transform 150ms var(--ease-out), background-color 150ms ease;
    }

    .journal-title { transition: text-decoration-color 150ms ease; }

    @media (hover: hover) and (pointer: fine) {
      .journal-entry:hover .journal-copy { transform: translateX(4px); }
      .journal-entry:hover .journal-node { transform: scale(1.3); }
    }

    .journal-entry:active .journal-copy { transform: translateX(1px); }
    .journal-entry:active .journal-node { transform: scale(0.85); }
  }
</style>

<script is:inline>
  (() => {
    const viewport = document.getElementById('vertical-timeline-viewport');
    if (!viewport) return;

    let isDown = false;
    let startY = 0;
    let scrollTop = 0;
    let dragged = false;

    viewport.addEventListener('mousedown', (e) => {
      if (e.button !== 0 || viewport.scrollHeight <= viewport.clientHeight) return;
      isDown = true;
      dragged = false;
      startY = e.pageY - viewport.offsetTop;
      scrollTop = viewport.scrollTop;
      viewport.classList.add('sm:cursor-grabbing');
    });

    window.addEventListener('mouseup', () => {
      isDown = false;
      viewport.classList.remove('sm:cursor-grabbing');
    });

    viewport.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      const y = e.pageY - viewport.offsetTop;
      const walk = y - startY;
      if (!dragged && Math.abs(walk) <= 6) return;
      dragged = true;
      viewport.scrollTop = scrollTop - walk;
    });

    // Prevent accidental navigation immediately after dragging
    viewport.addEventListener(
      'click',
      (e) => {
        if (dragged && e.detail > 0) {
          e.preventDefault();
          dragged = false;
        }
      },
      true,
    );
  })();
</script>
