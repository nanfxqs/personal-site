---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import JournalCoverFlow from '@/components/journal/JournalCoverFlow.astro';
import { buttonVariants } from '@/components/ui/button';
import {
  compareJournalPosts,
  formatJournalDate,
  formatJournalDateTimeAttr,
} from '@/lib/journal-date';
import { normalizeJournalSlug } from '@/lib/kb-graph';

const posts = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  compareJournalPosts,
);
const covers = posts.map(({ id, data }) => ({
  href: `/journal/${normalizeJournalSlug(id)}`,
  title: data.title,
  date: formatJournalDate(data.date, data.datePrecision, data.dateLabel),
  cover: data.cover,
}));
---

<BaseLayout title="个人日常" wide>
  <header class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 border-b border-border/80 pt-7 pb-5 sm:flex-row sm:items-end sm:justify-between sm:pt-10 sm:pb-6">
      <div>
        <h1 class="font-editorial text-3xl leading-[1.2] text-foreground sm:text-4xl">
          个人日常与随笔
        </h1>
        <p class="mt-2 text-sm text-muted-foreground tabular-nums">
          生活片段、随笔感慨与影像记录 · 共 {posts.length} 篇
        </p>
      </div>
      {covers.length > 0 && (
        <div
          id="journal-view-switch"
          hidden
          role="group"
          aria-label="日常浏览方式"
          class="w-fit gap-1 rounded-full border border-border/75 bg-muted/70 p-1"
        >
          <button
            type="button"
            class="journal-switch-btn rounded-full px-3.5 py-1.5 text-xs font-medium text-muted-foreground transition-[background-color,color,box-shadow] duration-150 ease-[var(--ease-out)] cursor-pointer hover:text-foreground"
            data-journal-panel="journal-cover-flow"
            aria-controls="journal-cover-flow"
            aria-pressed="true"
          >
            立体浏览
          </button>
          <button
            type="button"
            class="journal-switch-btn rounded-full px-3.5 py-1.5 text-xs font-medium text-muted-foreground transition-[background-color,color,box-shadow] duration-150 ease-[var(--ease-out)] cursor-pointer hover:text-foreground"
            data-journal-panel="journal-timeline"
            aria-controls="journal-timeline"
            aria-pressed="false"
          >
            时间线
          </button>
        </div>
      )}
    </div>
  </header>

  {posts.length === 0 ? (
    <section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
      <p class="font-editorial text-lg text-foreground">还没有公开发布的日常随笔</p>
      <p class="mt-2 text-sm text-muted-foreground">可以先去浏览考研知识库，或回到首页查看整体进度。</p>
      <div class="mt-5 flex justify-center gap-2.5">
        <a href="/kb" class={buttonVariants({ variant: 'default', size: 'sm', className: 'rounded-full' })}>
          浏览知识库
        </a>
        <a href="/" class={buttonVariants({ variant: 'outline', size: 'sm', className: 'rounded-full' })}>
          返回首页
        </a>
      </div>
    </section>
  ) : (
    <>
      <JournalCoverFlow entries={covers} />

      <!-- Vertical Draggable & Fading Timeline (natural page scroll on mobile, fading viewport on md+) -->
      <section id="journal-timeline" class="mx-auto max-w-5xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
        <div
          id="vertical-timeline-viewport"
          class="no-scrollbar relative px-1 py-2 sm:px-2 md:timeline-fade-mask md:max-h-[72vh] md:overflow-y-auto md:py-8 md:select-none md:cursor-grab"
        >
          <div class="relative mx-auto max-w-3xl border-l border-border/80 pl-6 sm:pl-9">
            {
              posts.map((post) => {
                const slug = normalizeJournalSlug(post.id);
                const dateStr = formatJournalDate(post.data.date, post.data.datePrecision, post.data.dateLabel);
                const dateTimeAttr = formatJournalDateTimeAttr(
                  post.data.date,
                  post.data.datePrecision,
                );
                return (
                  <article
                    data-timeline-item
                    class="relative border-b border-border/45 last:border-b-0"
                  >
                    <a
                      href={`/journal/${slug}`}
                      draggable="false"
                      class="journal-entry relative block rounded-sm py-5 pr-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary sm:py-6"
                    >
                      <span
                        aria-hidden="true"
                        class="journal-node absolute -left-6 top-[1.85rem] size-2 -translate-x-1/2 -translate-y-1/2 rounded-full border border-primary bg-background sm:-left-9 sm:top-[2.15rem]"
                      />
                      <div class="journal-copy flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-6">
                        <div class="shrink-0 text-xs text-muted-foreground tabular-nums sm:w-32">
                          {dateTimeAttr ? <time datetime={dateTimeAttr}>{dateStr}</time> : dateStr}
                        </div>

                        <div class="min-w-0 flex-1">
                          <h2 class="journal-title font-editorial text-xl leading-[1.35] text-foreground sm:text-[1.35rem]">
                            {post.data.title}
                          </h2>

                          {post.data.summary && (
                            <p class="mt-2 font-editorial text-sm leading-[1.75] text-muted-foreground">
                              {post.data.summary}
                            </p>
                          )}

                          {(post.data.mood || post.data.media.length > 0 || post.data.tags.length > 0) && (
                            <div class="mt-2.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-muted-foreground">
                              {post.data.mood && <span>{post.data.mood}</span>}
                              {post.data.media.length > 0 && <span>含 {post.data.media.length} 个媒体附件</span>}
                              {post.data.tags.map((tag) => (
                                <span>#{tag}</span>
                              ))}
                            </div>
                          )}
                        </div>
                      </div>
                    </a>
                  </article>
                );
              })
            }
          </div>
        </div>
      </section>
    </>
  )}
</BaseLayout>

<style>
  #journal-view-switch:not([hidden]) { display: inline-flex; }

  #journal-view-switch button[aria-pressed="true"] {
    background: var(--primary);
    color: var(--primary-foreground);
    box-shadow: 0 1px 2px rgba(12, 23, 38, 0.12);
  }

  .journal-title {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
  }

  .journal-entry:focus-visible .journal-title {
    color: var(--primary);
    text-decoration-color: var(--primary);
  }

  .journal-entry:focus-visible .journal-node {
    background-color: var(--primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .journal-entry:hover .journal-title {
      color: var(--primary);
      text-decoration-color: color-mix(in srgb, var(--primary) 55%, transparent);
    }
    .journal-entry:hover .journal-node { background-color: var(--primary); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .journal-copy, .journal-node {
      transition: transform 150ms var(--ease-out), background-color 150ms ease;
    }

    .journal-title { transition: color 150ms ease, text-decoration-color 150ms ease; }

    @media (hover: hover) and (pointer: fine) {
      .journal-entry:hover .journal-copy { transform: translateX(3px); }
      .journal-entry:hover .journal-node { transform: scale(1.3); }
    }

    .journal-entry:active .journal-copy { transform: translateX(1px); }
    .journal-entry:active .journal-node { transform: scale(0.85); }
  }
</style>

<script>
  const viewSwitch = document.getElementById('journal-view-switch');
  if (viewSwitch) {
    const buttons = viewSwitch.querySelectorAll<HTMLButtonElement>('[data-journal-panel]');
    const selectView = (selectedId: string) => {
      for (const button of buttons) {
        const active = button.dataset.journalPanel === selectedId;
        button.setAttribute('aria-pressed', String(active));
        const panel = document.getElementById(button.dataset.journalPanel ?? '');
        if (panel) panel.hidden = !active;
      }
    };
    selectView('journal-cover-flow');
    for (const button of buttons) {
      button.addEventListener('click', () => selectView(button.dataset.journalPanel ?? ''));
    }
    viewSwitch.hidden = false;
  }
</script>

<script is:inline>
  (() => {
    const viewport = document.getElementById('vertical-timeline-viewport');
    if (!viewport) return;

    let isDown = false;
    let startY = 0;
    let scrollTop = 0;
    let dragged = false;

    viewport.addEventListener('mousedown', (e) => {
      if (e.button !== 0 || viewport.scrollHeight <= viewport.clientHeight) return;
      isDown = true;
      dragged = false;
      startY = e.pageY - viewport.offsetTop;
      scrollTop = viewport.scrollTop;
      viewport.classList.add('sm:cursor-grabbing');
    });

    window.addEventListener('mouseup', () => {
      isDown = false;
      viewport.classList.remove('sm:cursor-grabbing');
    });

    viewport.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      const y = e.pageY - viewport.offsetTop;
      const walk = y - startY;
      if (!dragged && Math.abs(walk) <= 6) return;
      dragged = true;
      viewport.scrollTop = scrollTop - walk;
    });

    // Prevent accidental navigation immediately after dragging
    viewport.addEventListener(
      'click',
      (e) => {
        if (dragged && e.detail > 0) {
          e.preventDefault();
          dragged = false;
        }
      },
      true,
    );
  })();
</script>
