---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatJournalDate, formatJournalDateTimeAttr } from '@/lib/journal-date';
import { getKnowledgeIndex, normalizeJournalSlug } from '@/lib/kb-graph';

export async function getStaticPaths() {
  const posts = await getCollection('journal', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: normalizeJournalSlug(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const index = await getKnowledgeIndex();
const dateStr = formatJournalDate(post.data.date, post.data.datePrecision);
const dateTimeAttr = formatJournalDateTimeAttr(post.data.date, post.data.datePrecision);
const referenced = post.data.referencedTopics
  .map((id) => index.topicsById.get(id))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <article data-pagefind-body class="mx-auto max-w-3xl py-12">
    <header class="border-b border-[var(--border)] pb-8">
      <div class="flex flex-wrap items-center gap-2 text-xs text-[var(--text-muted)]">
        <a href="/journal" class="hover:text-[var(--accent)]">← 返回日常</a>
        <span>·</span>
        <time datetime={dateTimeAttr} class="font-mono">{dateStr}</time>
        {post.data.mood && (
          <>
            <span>·</span>
            <span>{post.data.mood}</span>
          </>
        )}
      </div>

      <h1 class="mt-4 font-editorial text-3xl font-semibold leading-tight text-[var(--text)] sm:text-4xl">
        {post.data.title}
      </h1>

      {post.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {post.data.tags.map((tag) => (
            <span class="rounded-full border border-[var(--border)] bg-[var(--surface)] px-2.5 py-0.5 text-xs text-[var(--text-muted)]">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-editorial dark:prose-invert mt-10 max-w-none">
      <Content />
    </div>

    {post.data.media.length > 0 && (
      <section class="mt-10 space-y-6 border-t border-[var(--border)] pt-8">
        <h2 class="font-editorial text-lg font-semibold text-[var(--text)]">媒体附件</h2>
        {post.data.media.map((item) => (
          <figure class="overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-4">
            {item.kind === 'image' && (
              <img src={item.url} alt={item.caption ?? ''} class="w-full rounded-xl object-cover" loading="lazy" />
            )}
            {item.kind === 'audio' && (
              <audio controls src={item.url} class="w-full" />
            )}
            {item.kind === 'video' && (
              <video controls src={item.url} class="w-full rounded-xl" />
            )}
            {item.kind === 'embed' && (
              <iframe
                src={item.url}
                class="aspect-video w-full rounded-xl border-0"
                allowfullscreen
                loading="lazy"
              />
            )}
            {item.caption && (
              <figcaption class="mt-2 text-xs text-[var(--text-muted)]">{item.caption}</figcaption>
            )}
          </figure>
        ))}
      </section>
    )}

    {referenced.length > 0 && (
      <section class="mt-12 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5">
        <h2 class="font-editorial text-sm font-semibold text-[var(--text)]">
          本文提及的考研知识点
        </h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {referenced.map((topic) => (
            <a
              href={topic.href}
              class="inline-flex items-center gap-1.5 rounded-full border border-[var(--border)] bg-[var(--surface-subtle)] px-3 py-1 text-xs text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors"
            >
              <span>{topic.title}</span>
              <span class="text-[10px] text-[var(--text-muted)]">{topic.courseShortTitle}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
