---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { formatJournalDate, formatJournalDateTimeAttr } from '@/lib/journal-date';
import { getKnowledgeIndex, normalizeJournalSlug } from '@/lib/kb-graph';

export async function getStaticPaths() {
  const posts = await getCollection('journal', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: normalizeJournalSlug(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const index = await getKnowledgeIndex();
const dateStr = formatJournalDate(post.data.date, post.data.datePrecision, post.data.dateLabel);
const dateTimeAttr = formatJournalDateTimeAttr(post.data.date, post.data.datePrecision);
const referenced = post.data.referencedTopics
  .map((id) => index.topicsById.get(id))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <article data-pagefind-body class="mx-auto max-w-[44rem] py-10 sm:py-14">
    <header class="border-b border-border/80 pb-7">
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-muted-foreground">
        <a
          href="/journal"
          class="inline-flex items-center gap-1 rounded-sm font-medium text-muted-foreground transition-colors hover:text-primary"
        >
          <span aria-hidden="true">←</span>
          <span>返回日常</span>
        </a>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 tabular-nums">
          <span>
            {dateTimeAttr ? <time datetime={dateTimeAttr}>{dateStr}</time> : dateStr}
          </span>
          {post.data.mood && (
            <>
              <span aria-hidden="true" class="opacity-40">/</span>
              <span>{post.data.mood}</span>
            </>
          )}
        </div>
      </div>

      <h1 class="mt-5 font-editorial text-2xl leading-[1.28] text-balance text-foreground sm:text-[2.125rem]">
        {post.data.title}
      </h1>

      {post.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted-foreground">
          {post.data.tags.map((tag) => (
            <span>#{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-editorial dark:prose-invert mt-9 max-w-none">
      <Content />
    </div>

    {post.data.media.length > 0 && (
      <section class="mt-10 space-y-6 border-t border-border/80 pt-8">
        <h2 class="font-editorial text-lg text-foreground">媒体附件</h2>
        {post.data.media.map((item) => (
          <figure class="overflow-hidden rounded-xl border border-border/80 bg-card/80 p-4">
            {item.kind === 'image' && (
              <img src={item.url} alt={item.caption ?? ''} class="w-full rounded-lg object-cover" loading="lazy" />
            )}
            {item.kind === 'audio' && (
              <audio controls src={item.url} class="w-full" />
            )}
            {item.kind === 'video' && (
              <video controls src={item.url} class="w-full rounded-lg" />
            )}
            {item.kind === 'embed' && (
              <iframe
                src={item.url}
                class="aspect-video w-full rounded-lg border-0"
                allowfullscreen
                loading="lazy"
              />
            )}
            {item.caption && (
              <figcaption class="mt-2.5 text-xs text-muted-foreground">{item.caption}</figcaption>
            )}
          </figure>
        ))}
      </section>
    )}

    {referenced.length > 0 && (
      <section class="mt-12 rounded-xl border border-border/80 bg-card/80 p-5 text-card-foreground">
        <h2 class="font-editorial text-base text-foreground">
          本文提及的考研知识点
        </h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {referenced.map((topic) => (
            <a
              href={topic.href}
              class={cn(buttonVariants({ variant: 'outline', size: 'xs' }), 'rounded-full')}
            >
              <span>{topic.title}</span>
              <span class="text-[10px] text-muted-foreground">{topic.courseShortTitle}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
