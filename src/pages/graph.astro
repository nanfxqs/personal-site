---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { KnowledgeGraph } from '@/components/kb/KnowledgeGraph';
import { getKnowledgeIndex } from '@/lib/kb-graph';

const index = await getKnowledgeIndex();
---

<BaseLayout title="知识图谱" wide>
  <div class="mx-auto px-3 py-4 sm:px-6 sm:py-5 lg:px-8">
    <KnowledgeGraph
      client:load
      nodes={index.graph.nodes}
      edges={index.graph.edges}
    />
  </div>
</BaseLayout>
