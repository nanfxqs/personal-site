---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import MountainProgress from '@/components/home/MountainProgress.astro';
import { SITE } from '@/config/site';
import { SUBJECT_LIST } from '@/data/syllabus';
import { getKnowledgeIndex, normalizeJournalSlug } from '@/lib/kb-graph';

const index = await getKnowledgeIndex();
const posts = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const latestPost = posts[0];
const latestSlug = latestPost ? normalizeJournalSlug(latestPost.id) : null;
const latestDate = latestPost ? latestPost.data.date.toISOString().slice(0, 10) : null;

const peakHeights: Record<string, number> = {
  '408': 24,
  math1: 30,
  english1: 38,
};

const mountainItems = SUBJECT_LIST.map((subject) => ({
  id: subject.id,
  title: subject.title,
  subtitle: subject.courses.map((c) => c.shortTitle).join(' · '),
  href: `/kb/${subject.id}`,
  stats: index.subjectStats[subject.id],
  peakY: peakHeights[subject.id] ?? 30,
}));
---

<BaseLayout>
  <!-- Editorial Monochrome Profile Header -->
  <section class="border-b border-[var(--border)] py-14 sm:py-20">
    <div class="max-w-2xl space-y-5">
      <div class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)] px-3 py-1 text-xs text-[var(--text-muted)]">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        <span>{SITE.status}</span>
      </div>

      <h1 class="font-editorial text-4xl font-semibold tracking-tight text-[var(--text)] sm:text-5xl">
        你好，我是 <span class="italic">{SITE.nickname}</span>
      </h1>

      <p class="font-editorial text-base leading-relaxed text-[var(--text-muted)] sm:text-lg">
        {SITE.bio}
      </p>
    </div>

    <!-- Plan A: Minimalist Journal Dispatch Note (No full journal feed on Home) -->
    <div class="mt-10">
      <a
        href={latestSlug ? `/journal/${latestSlug}` : '/journal'}
        class="group flex flex-col justify-between gap-4 rounded-2xl border border-dashed border-[var(--border)] bg-[var(--surface)]/70 p-5 transition-colors hover:border-[var(--text)] sm:flex-row sm:items-center"
      >
        <div class="min-w-0 space-y-1">
          <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)]">
            <span>Latest Dispatch · 个人日常</span>
            {latestDate && <span>/ {latestDate}</span>}
          </div>
          <div class="truncate font-editorial text-base font-medium text-[var(--text)]">
            {latestPost ? latestPost.data.title : '日常随笔、图像与影音时间线'}
          </div>
        </div>
        <div class="flex shrink-0 items-center gap-3 text-xs text-[var(--text-muted)]">
          <span>共 {posts.length} 篇手记</span>
          <span class="rounded-full border border-[var(--border)] px-3 py-1 font-medium text-[var(--text)] group-hover:bg-[var(--text)] group-hover:text-[var(--bg)] transition-colors">
            进入时间线 →
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- Three Mountains Study Progress -->
  <section class="py-12 sm:py-16">
    <div class="mb-8 flex flex-wrap items-baseline justify-between gap-4">
      <div>
        <h2 class="font-editorial text-2xl font-semibold text-[var(--text)]">
          三山攀登 · 考研知识库进度
        </h2>
        <p class="mt-1 text-xs text-[var(--text-muted)]">
          已沉淀 {index.overallStats.published} / {index.overallStats.total} 个核心知识点 · 已掌握 {index.overallStats.mastered} 个
        </p>
      </div>
      <a
        href="/graph"
        class="text-xs font-medium text-[var(--text-muted)] underline decoration-[var(--border)] underline-offset-4 hover:text-[var(--text)] transition-colors"
      >
        查看跨科知识图谱 →
      </a>
    </div>

    <MountainProgress items={mountainItems} />
  </section>
</BaseLayout>
