---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SUBJECT_LIST } from '@/data/syllabus';
import { getKnowledgeIndex } from '@/lib/kb-graph';
import { badgeVariants } from '@/components/ui/badge';
import { cn } from '@/lib/utils';

const index = await getKnowledgeIndex();
---

<BaseLayout title="考研知识库">
  <header class="border-b border-border/80 py-12">
    <h1 class="font-editorial text-3xl font-semibold text-foreground sm:text-4xl">
      考研知识库总览
    </h1>
    <p class="mt-2.5 max-w-2xl text-sm leading-relaxed text-muted-foreground">
      按学科分模块组织，每个原子知识点均为独立可插拔内容包，支持跨书、跨学科双向引用与原理交互可视化。
    </p>
  </header>

  <section class="grid grid-cols-1 gap-6 py-10">
    {
      SUBJECT_LIST.map((subject) => {
        const stats = index.subjectStats[subject.id];
        return (
          <div
            data-spotlight
            class="glass-surface spotlight-card rounded-2xl p-6 text-card-foreground"
          >
            <div class="flex flex-wrap items-baseline justify-between gap-4">
              <div>
                <a
                  href={`/kb/${subject.id}`}
                  class="group inline-flex items-center gap-2 font-editorial text-2xl font-semibold text-foreground transition-colors hover:opacity-80"
                >
                  <span>{subject.title}</span>
                  <span class="text-sm font-sans text-muted-foreground transition-transform group-hover:translate-x-0.5 group-hover:text-foreground">
                    →
                  </span>
                </a>
                <p class="mt-1 text-sm text-muted-foreground">{subject.description}</p>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <span class={cn(badgeVariants({ variant: 'outline' }), 'font-mono')}>
                  进度 {stats.percent}%
                </span>
                <span class={badgeVariants({ variant: 'success' })}>
                  已掌握 {stats.mastered}
                </span>
              </div>
            </div>

            <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
              {subject.courses.map((course) => {
                const cStats = index.courseStats.get(`${subject.id}/${course.id}`);
                const href = `/kb/${subject.id}/${course.id}`;
                const cPct = cStats?.percent ?? 0;
                return (
                  <a
                    href={href}
                    class="group flex flex-col justify-between rounded-xl border border-border bg-muted/35 p-4 shadow-2xs transition-all hover:border-foreground/25 hover:bg-accent/60 hover:shadow-xs"
                  >
                    <div>
                      <div class="flex items-center justify-between gap-2">
                        <span class="font-medium text-sm text-foreground group-hover:underline decoration-border underline-offset-4">
                          {course.title}
                        </span>
                        <span class="font-mono text-[11px] text-muted-foreground">
                          {cPct}%
                        </span>
                      </div>
                      <div class="mt-1 text-xs text-muted-foreground">{course.scoreShare}</div>
                    </div>
                    <div class="course-progress-track mt-3.5 h-1 w-full overflow-hidden rounded-full">
                      <div
                        class="course-progress-fill h-full rounded-full"
                        style={`width: ${cPct}%;`}
                      />
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        );
      })
    }
  </section>
</BaseLayout>
