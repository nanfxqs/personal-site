---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SUBJECT_LIST, type SubjectId } from '@/data/syllabus';
import { getKnowledgeIndex } from '@/lib/kb-graph';

const index = await getKnowledgeIndex();

const subjectAccent: Record<SubjectId, { dot: string; bar: string }> = {
  '408': {
    dot: 'bg-[var(--subject-408)]',
    bar: 'bg-[var(--subject-408)]',
  },
  math1: {
    dot: 'bg-[var(--subject-math1)]',
    bar: 'bg-[var(--subject-math1)]',
  },
  english1: {
    dot: 'bg-[var(--subject-english1)]',
    bar: 'bg-[var(--subject-english1)]',
  },
};

const totalCourses = SUBJECT_LIST.reduce((acc, s) => acc + s.courses.length, 0);
---

<BaseLayout title="考研知识库">
  <header class="pt-10 pb-8 sm:pt-14 sm:pb-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <h1 class="font-editorial text-3xl leading-[1.2] text-foreground sm:text-4xl">
          考研知识库总览
        </h1>
        <p class="mt-3 text-sm leading-[1.75] text-muted-foreground sm:text-[15px]">
          按学科与书目组织，每个原子知识点均为独立内容包，支持跨书、跨学科双向引用与原理交互可视化。
        </p>
      </div>
      <a
        href="/graph"
        class="group inline-flex w-fit items-center gap-1.5 rounded-md text-sm font-medium text-primary transition-colors hover:text-primary/80"
      >
        <span>查看跨科知识图谱</span>
        <span aria-hidden="true" class="transition-transform duration-150 ease-[var(--ease-out)] group-hover:translate-x-0.5">→</span>
      </a>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-1.5 border-t border-border/70 pt-4 text-xs text-muted-foreground tabular-nums">
      <span>共 {SUBJECT_LIST.length} 门学科 · {totalCourses} 门书目</span>
      <span>已点亮 {index.overallStats.published} / {index.overallStats.total} 个知识点</span>
      <span>已掌握 {index.overallStats.mastered} · 总体进度 {index.overallStats.percent}%</span>
    </div>
  </header>

  <section aria-label="学科与书目目录" class="divide-y divide-border/75 pb-16">
    {
      SUBJECT_LIST.map((subject) => {
        const stats = index.subjectStats[subject.id];
        const accent = subjectAccent[subject.id];
        return (
          <div class="py-8 first:pt-4 sm:py-10 first:sm:pt-6">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <div class="min-w-0">
                <a
                  href={`/kb/${subject.id}`}
                  class="group inline-flex items-baseline gap-2.5 rounded-sm font-editorial text-2xl leading-[1.25] text-foreground transition-colors hover:text-primary sm:text-[1.7rem]"
                >
                  <span class={`mb-0.5 inline-block size-2 shrink-0 self-center rounded-full ${accent.dot}`} aria-hidden="true" />
                  <span>{subject.title}</span>
                  <span
                    aria-hidden="true"
                    class="font-sans text-sm text-muted-foreground transition-[transform,color] duration-150 ease-[var(--ease-out)] group-hover:translate-x-0.5 group-hover:text-primary"
                  >
                    →
                  </span>
                </a>
                <p class="mt-2 max-w-2xl text-sm leading-[1.7] text-muted-foreground">
                  {subject.description}
                </p>
              </div>

              <div class="shrink-0 text-xs text-muted-foreground tabular-nums sm:text-right">
                <span class="font-medium text-foreground">进度 {stats.percent}%</span>
                <span class="mx-1.5 opacity-45">/</span>
                <span>已点亮 {stats.published}/{stats.total}</span>
                {stats.mastered > 0 && (
                  <>
                    <span class="mx-1.5 opacity-45">/</span>
                    <span class="text-emerald-700 dark:text-emerald-400">已掌握 {stats.mastered}</span>
                  </>
                )}
              </div>
            </div>

            <div class="mt-6 grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-4">
              {subject.courses.map((course) => {
                const cStats = index.courseStats.get(`${subject.id}/${course.id}`);
                const href = `/kb/${subject.id}/${course.id}`;
                const cPct = cStats?.percent ?? 0;
                const cPublished = cStats?.published ?? 0;
                const cTotal = cStats?.total ?? 0;
                return (
                  <a
                    href={href}
                    class="kb-course-card group flex min-h-[7.25rem] flex-col justify-between rounded-xl border border-border/75 bg-card/85 p-4 transition-[border-color,background-color,transform] duration-150 ease-[var(--ease-out)] hover:border-primary/45 hover:bg-card"
                  >
                    <div>
                      <h2 class="text-[15px] font-medium leading-snug text-foreground transition-colors group-hover:text-primary">
                        {course.title}
                      </h2>
                      <p class="mt-1.5 text-xs text-muted-foreground">
                        {course.scoreShare}
                      </p>
                    </div>

                    <div class="mt-5">
                      <div class="flex items-baseline justify-between gap-2 text-[11px] text-muted-foreground tabular-nums">
                        <span>{cPublished > 0 ? `已点亮 ${cPublished}/${cTotal}` : `共 ${cTotal} 个知识点`}</span>
                        <span class={cPct > 0 ? 'font-medium text-foreground' : 'text-muted-foreground'}>
                          {cPct}%
                        </span>
                      </div>
                      <div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-muted/90">
                        <div
                          class={`h-full rounded-full transition-[width] duration-500 ease-[var(--ease-out)] ${accent.bar}`}
                          style={`width: ${cPct}%;`}
                        />
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        );
      })
    }
  </section>
</BaseLayout>

<style>
  @media (hover: hover) and (pointer: fine) {
    .kb-course-card:hover {
      transform: translateY(-1px);
    }
  }
</style>
