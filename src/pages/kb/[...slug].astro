---
import { render } from 'astro:content';
import KbLayout from '@/layouts/KbLayout.astro';
import StudyStatusBadge from '@/components/kb/StudyStatusBadge.astro';
import { getKnowledgeIndex } from '@/lib/kb-graph';

export async function getStaticPaths() {
  const index = await getKnowledgeIndex();
  return index.allTopics.map((topic) => ({
    params: { slug: topic.id },
    props: { topicId: topic.id },
  }));
}

const { topicId } = Astro.props;
const index = await getKnowledgeIndex();
const topic = index.topicsById.get(topicId)!;

const rendered = topic.entry ? await render(topic.entry) : null;
const Content = rendered?.Content;
const headings = rendered?.headings ?? [];
const sources = topic.entry?.data.sources ?? [];
const tags = topic.entry?.data.tags ?? [];
const updatedAt = topic.entry?.data.updatedAt;
---

<KbLayout topic={topic} headings={headings}>
  <!-- Breadcrumb & Header -->
  <header class="border-b border-[var(--border)] pb-6">
    <nav aria-label="面包屑" class="flex flex-wrap items-center gap-1.5 text-xs text-[var(--text-muted)]">
      <a href={`/kb/${topic.subjectId}`} class="hover:text-[var(--accent)]">
        {topic.subjectTitle}
      </a>
      <span>/</span>
      <span>{topic.courseTitle}</span>
      <span>/</span>
      <span>{topic.chapterTitle}</span>
      <span>/</span>
      <span class="text-[var(--text)]">{topic.sectionTitle}</span>
    </nav>

    <h1 class="mt-3 font-editorial text-3xl font-semibold leading-tight text-[var(--text)] sm:text-4xl">
      {topic.title}
    </h1>

    {topic.summary && (
      <p class="mt-3 text-base leading-relaxed text-[var(--text-muted)]">
        {topic.summary}
      </p>
    )}

    <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
      <StudyStatusBadge status={topic.status} />
      {topic.weight && (
        <span class="rounded-full border border-[var(--border)] bg-[var(--surface)] px-2.5 py-0.5 text-amber-600 dark:text-amber-400">
          考频 {topic.weight}
        </span>
      )}
      {topic.textbookRef && (
        <span class="rounded-full border border-[var(--border)] bg-[var(--surface)] px-2.5 py-0.5 text-[var(--text-muted)]">
          教材：{topic.textbookRef}
        </span>
      )}
      {updatedAt && (
        <span class="font-mono text-[var(--text-muted)]">
          更新于 {updatedAt.toISOString().slice(0, 10)}
        </span>
      )}
      {tags.map((tag) => (
        <span class="rounded-full bg-[var(--surface-subtle)] px-2 py-0.5 text-[var(--text-muted)]">
          #{tag}
        </span>
      ))}
    </div>
  </header>

  <!-- Main Content or Stub Topic Placeholder (ADR-0002) -->
  {
    Content ? (
      <div class="prose prose-editorial dark:prose-invert mt-8 max-w-none">
        <Content />
      </div>
    ) : (
      <section class="mt-8 rounded-2xl border border-dashed border-[var(--border)] bg-[var(--surface)] p-8 text-center">
        <div class="mx-auto inline-flex h-10 w-10 items-center justify-center rounded-full bg-[var(--surface-subtle)] font-editorial text-lg text-[var(--text-muted)]">
          §
        </div>
        <h2 class="mt-4 font-editorial text-xl font-semibold text-[var(--text)]">
          待学占位节点 (Stub Topic)
        </h2>
        <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-[var(--text-muted)]">
          该知识点已在大纲中注册，支持被其他章节或学科提前跨科引用。待学习完成后，由 Agent 在
          <code class="mx-1 rounded bg-[var(--surface-subtle)] px-1.5 py-0.5 text-xs">
            src/content/kb/{topic.id}/index.mdx
          </code>
          写入正文与交互可视化组件即可自动点亮。
        </p>
        {topic.vizHint && (
          <p class="mt-3 text-xs text-[var(--accent)]">
            推荐交互形态：{topic.vizHint.toUpperCase()} 可视化演示
          </p>
        )}
      </section>
    )
  }

  <!-- Reference Sources -->
  {
    sources.length > 0 && (
      <section class="mt-12 border-t border-[var(--border)] pt-6">
        <h2 class="font-editorial text-base font-semibold text-[var(--text)]">
          参考源 (Reference Sources)
        </h2>
        <ul class="mt-3 space-y-2 text-sm">
          {sources.map((src) => (
            <li class="flex flex-wrap items-baseline gap-2 text-[var(--text-muted)]">
              <span class="text-[var(--accent)]">•</span>
              {src.url ? (
                <a
                  href={src.url}
                  target="_blank"
                  rel="noreferrer"
                  class="font-medium text-[var(--text)] underline decoration-[var(--border)] underline-offset-4 hover:text-[var(--accent)]"
                >
                  {src.title}
                </a>
              ) : (
                <span class="font-medium text-[var(--text)]">{src.title}</span>
              )}
              {src.note && <span class="text-xs">— {src.note}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</KbLayout>
