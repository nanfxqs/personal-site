---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StudyStatusBadge from '@/components/kb/StudyStatusBadge.astro';
import CircularProgress from '@/components/kb/CircularProgress.astro';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { SUBJECT_LIST, SYLLABI, type SubjectId } from '@/data/syllabus';
import { getKnowledgeIndex } from '@/lib/kb-graph';

export function getStaticPaths() {
  return SUBJECT_LIST.map((subject) => ({
    params: { subject: subject.id },
  }));
}

const subjectId = Astro.params.subject as SubjectId;
const subject = SYLLABI[subjectId];
const index = await getKnowledgeIndex();
const stats = index.subjectStats[subjectId];

const subjectWrittenPercent =
  stats.total > 0 ? Math.round((stats.published / stats.total) * 100) : 0;
const subjectDisplayPercent =
  stats.percent > 0
    ? stats.percent
    : stats.published > 0
      ? Math.max(1, subjectWrittenPercent)
      : 0;
---

<BaseLayout title={subject.title} description={subject.description}>
  <header class="border-b border-border/80 py-12">
    <div class="flex flex-wrap items-center justify-between gap-6">
      <div>
        <h1 class="font-editorial text-3xl font-semibold text-foreground sm:text-4xl">
          {subject.title}
        </h1>
        <p class="mt-2.5 max-w-2xl font-editorial text-sm leading-relaxed text-muted-foreground">
          {subject.description}
        </p>
      </div>

      <!-- Dynamic Morning Frost Circular Progress for Subject -->
      <div
        data-spotlight
        class="glass-surface spotlight-card flex items-center gap-4 rounded-2xl px-5 py-3.5 text-card-foreground"
      >
        <CircularProgress
          percent={subjectDisplayPercent}
          secondaryPercent={subjectWrittenPercent}
          size={80}
          label="进度"
          idPrefix={`subject-${subject.id}`}
          title={`${subject.title} · 学习进度 ${subjectDisplayPercent}% · 已写入 ${stats.published}/${stats.total} · 已掌握 ${stats.mastered} · 学习中 ${stats.inProgress}`}
        />
        <div class="space-y-1.5 text-xs tabular-nums">
          <div class="font-medium text-foreground">学习状态</div>
          <div class="flex items-center gap-1.5 text-foreground">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            <span>已掌握 {stats.mastered}</span>
          </div>
          <div class="flex items-center gap-1.5 text-muted-foreground">
            <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
            <span>学习中 {stats.inProgress}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Course quick anchor links -->
    <div class="mt-6 flex flex-wrap gap-2">
      {
        subject.courses.map((course) => (
          <a
            href={`#course-${course.id}`}
            class={cn(
              buttonVariants({ variant: 'outline', size: 'sm' }),
              'h-8 rounded-full px-3.5',
            )}
          >
            <span>{course.title}</span>
            <span class="text-muted-foreground">· {course.scoreShare}</span>
          </a>
        ))
      }
    </div>
  </header>

  <div class="space-y-16 py-10">
    {
      subject.courses.map((course) => {
        const cStats = index.courseStats.get(`${subject.id}/${course.id}`);
        const cTotal = cStats?.total ?? 0;
        const cPublished = cStats?.published ?? 0;
        const cMastered = cStats?.mastered ?? 0;
        const cInProgress = cStats?.inProgress ?? 0;
        const courseWrittenPercent = cTotal > 0 ? Math.round((cPublished / cTotal) * 100) : 0;
        const courseDisplayPercent =
          (cStats?.percent ?? 0) > 0
            ? (cStats?.percent ?? 0)
            : cPublished > 0
              ? Math.max(1, courseWrittenPercent)
              : 0;

        const chaptersWithCounts = course.chapters.map((chapter) => {
          const topicIds = chapter.sections.flatMap((s) => s.topics.map((t) => t.id));
          const publishedCount = topicIds.filter(
            (id) => index.topicsById.get(id)?.isPublished,
          ).length;
          return {
            chapter,
            publishedCount,
            totalCount: topicIds.length,
          };
        });

        return (
          <section
            id={`course-${course.id}`}
            data-course-section={course.id}
            class="scroll-mt-24"
          >
            <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
              <div>
                <h2 class="font-editorial text-2xl font-semibold text-[var(--text)]">
                  <a
                    href={`/kb/${subject.id}/${course.id}`}
                    class="group inline-flex items-center gap-2 transition-colors hover:opacity-80"
                  >
                    <span class="underline decoration-transparent underline-offset-4 transition-colors group-hover:decoration-[var(--text-muted)]">
                      {course.title}
                    </span>
                    <span
                      aria-hidden="true"
                      class="inline-flex h-6 w-6 items-center justify-center rounded-full border border-[var(--border)] bg-[var(--surface)] font-sans text-xs font-normal text-[var(--text-muted)] transition-all group-hover:translate-x-0.5 group-hover:border-[var(--text)] group-hover:text-[var(--text)]"
                    >
                      →
                    </span>
                  </a>
                </h2>
                <p class="mt-1 text-xs text-[var(--text-muted)]">
                  {course.scoreShare} · {course.description}
                </p>
              </div>
            </div>

            {/* Horizontal gradient course progress bar directly above chapter linked-list nodes */}
            <div
              class="mb-3"
              role="progressbar"
              aria-valuenow={courseDisplayPercent}
              aria-valuemin={0}
              aria-valuemax={100}
              aria-label={`${course.title} 学习进度 ${courseDisplayPercent}%`}
              title={`${course.title} · 学习进度 ${courseDisplayPercent}% · 已掌握 ${cMastered} · 学习中 ${cInProgress}`}
              data-course-progress
              data-primary-width={courseDisplayPercent}
              data-secondary-width={courseWrittenPercent}
            >
              <div class="course-progress-track relative h-1.5 w-full overflow-hidden rounded-full">
                {courseWrittenPercent > courseDisplayPercent && (
                  <div
                    data-bar-secondary
                    class="course-progress-secondary absolute inset-y-0 left-0 rounded-full"
                    style="width: 0%;"
                  />
                )}
                <div
                  data-bar-primary
                  class="course-progress-fill relative h-full rounded-full"
                  style="width: 0%;"
                />
              </div>
            </div>

            {/* PC (md+): Edge-fading horizontal linked-list chapter bar (no scrollbar + arrows + wheel-to-horizontal + sliding indicator + click-to-center) */}
            <div class="hidden md:block">
              <div class="relative" data-linked-list-wrapper>
                <button
                  type="button"
                  data-scroll-prev
                  aria-label="向左滚动章节"
                  class="absolute left-0 top-1/2 z-20 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full border border-[var(--border)] bg-[var(--surface)]/95 text-sm text-[var(--text)] shadow-sm backdrop-blur-sm transition-all hover:border-[var(--text)] disabled:pointer-events-none disabled:opacity-0 cursor-pointer"
                >
                  ‹
                </button>
                <div
                  data-linked-list-bar
                  class="horizontal-fade-mask no-scrollbar relative flex items-center overflow-x-auto px-10 py-4 select-none cursor-grab"
                >
                  {/* Sliding frost-primary pill indicator behind the active chapter node */}
                  <div
                    data-active-indicator
                    aria-hidden="true"
                    class="pointer-events-none absolute left-0 top-1/2 z-0 rounded-full bg-primary opacity-0 shadow-[0_6px_18px_-6px_rgba(2,132,199,0.55)]"
                    style="transform: translate3d(0, -50%, 0); transition: transform 300ms var(--ease-out), width 300ms var(--ease-out), opacity 180ms ease;"
                  />

                  {chaptersWithCounts.map(({ chapter, publishedCount, totalCount }, chIdx) => {
                    const hasNotes = publishedCount > 0;
                    const isFirst = chIdx === 0;
                    return (
                      <div class="relative z-10 flex shrink-0 items-center">
                        {chIdx > 0 && (
                          <div class="flex items-center px-1.5 text-[var(--text-muted)]" aria-hidden="true">
                            <span class="h-px w-5 bg-[var(--border)]" />
                            <span class="-ml-1 text-[10px]">›</span>
                          </div>
                        )}
                        <button
                          type="button"
                          data-chapter-tab={chapter.id}
                          data-chapter-index={chIdx}
                          data-course-id={course.id}
                          data-active={isFirst ? 'true' : 'false'}
                          aria-pressed={isFirst ? 'true' : 'false'}
                          class:list={[
                            'chapter-node group flex items-center gap-2.5 rounded-full border px-3.5 py-2 text-xs cursor-pointer',
                            isFirst
                              ? 'border-primary bg-primary text-primary-foreground shadow-xs'
                              : 'border-border bg-card/80 text-foreground backdrop-blur-sm hover:border-[var(--specular-border)]',
                          ]}
                        >
                          {/* Linked-list node: solid = recorded, hollow = unrecorded */}
                          <span
                            title={hasNotes ? `已记入 ${publishedCount} 篇` : '暂未记入'}
                            class:list={[
                              'chapter-node-dot inline-block h-2.5 w-2.5 shrink-0 rounded-full border-[1.5px]',
                              hasNotes
                                ? isFirst
                                  ? 'border-primary-foreground bg-primary-foreground'
                                  : 'border-primary bg-primary'
                                : isFirst
                                  ? 'border-primary-foreground bg-transparent'
                                  : 'border-muted-foreground bg-transparent',
                            ]}
                          />
                          <span class="font-mono text-[11px] opacity-75">
                            {String(chapter.order).padStart(2, '0')}
                          </span>
                          <span class="font-editorial font-medium whitespace-nowrap">
                            {chapter.title}
                          </span>
                          <span class="font-mono text-[10px] opacity-70">
                            {publishedCount}/{totalCount}
                          </span>
                        </button>
                      </div>
                    );
                  })}
                </div>
                <button
                  type="button"
                  data-scroll-next
                  aria-label="向右滚动章节"
                  class="absolute right-0 top-1/2 z-20 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full border border-[var(--border)] bg-[var(--surface)]/95 text-sm text-[var(--text)] shadow-sm backdrop-blur-sm transition-all hover:border-[var(--text)] disabled:pointer-events-none disabled:opacity-0 cursor-pointer"
                >
                  ›
                </button>
              </div>

              {/* Active Chapter Detail Panel on PC */}
              <div class="mt-3 overflow-hidden">
                {chaptersWithCounts.map(({ chapter, publishedCount, totalCount }, chIdx) => (
                  <div
                    data-chapter-panel={chapter.id}
                    data-chapter-index={chIdx}
                    data-course-id={course.id}
                    data-spotlight
                    class:list={[
                      'glass-surface spotlight-card rounded-2xl p-6 text-card-foreground',
                      chIdx === 0 ? 'block' : 'hidden',
                    ]}
                  >
                    <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-[var(--border)] pb-3">
                      <div class="flex items-baseline gap-2">
                        <span class="font-mono text-xs text-[var(--text-muted)]">
                          Chapter {String(chapter.order).padStart(2, '0')}
                        </span>
                        <h3 class="font-editorial text-lg font-semibold text-[var(--text)]">
                          {chapter.title}
                        </h3>
                      </div>
                      <div class="flex items-center gap-3 text-xs text-[var(--text-muted)]">
                        {chapter.textbookRef && <span>{chapter.textbookRef}</span>}
                        <span class="font-mono">
                          已记入 {publishedCount}/{totalCount}
                        </span>
                      </div>
                    </div>

                    <div class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2">
                      {chapter.sections.map((section) => (
                        <div>
                          <div class="mb-2 text-[11px] font-medium tracking-wide text-[var(--text-muted)]">
                            {section.title}
                          </div>
                          <ul class="space-y-1">
                            {section.topics.map((stub) => {
                              const resolved = index.topicsById.get(stub.id);
                              const isPublished = resolved?.isPublished ?? false;
                              const status = resolved?.status ?? '未开始';
                              return (
                                <li>
                                  <a
                                    href={`/kb/${stub.id}`}
                                    class:list={[
                                      'flex items-center justify-between gap-2 rounded-lg px-2.5 py-1.5 text-xs transition-colors',
                                      isPublished
                                        ? 'bg-[var(--surface-subtle)] font-medium text-[var(--text)] hover:underline'
                                        : 'text-[var(--text-muted)] hover:bg-[var(--surface-subtle)] hover:text-[var(--text)]',
                                    ]}
                                  >
                                    <span class="flex items-center gap-2 min-w-0">
                                      <StudyStatusBadge status={status} compact />
                                      <span class="truncate">{resolved?.title ?? stub.title}</span>
                                    </span>
                                    <span class="flex shrink-0 items-center gap-1.5">
                                      {stub.math1Only && (
                                        <span class="rounded border border-[var(--border)] px-1 py-0.5 text-[9px] text-[var(--text-muted)]">
                                          数一
                                        </span>
                                      )}
                                      {stub.viz && (
                                        <span class="rounded border border-[var(--border)] px-1 py-0.5 font-mono text-[9px] uppercase text-[var(--text-muted)]">
                                          {stub.viz}
                                        </span>
                                      )}
                                      {stub.weight && (
                                        <span class="text-[10px] text-amber-600/80 dark:text-amber-400/80">
                                          {stub.weight}
                                        </span>
                                      )}
                                    </span>
                                  </a>
                                </li>
                              );
                            })}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>

            {/* Mobile (< md): Vertical linked-list chapter layout */}
            <div class="relative ml-2 border-l border-[var(--border)] pl-5 space-y-4 md:hidden">
              {chaptersWithCounts.map(({ chapter, publishedCount, totalCount }, chIdx) => {
                const hasNotes = publishedCount > 0;
                return (
                  <details open={chIdx === 0 || hasNotes} class="chapter-disclosure group relative">
                    {/* Vertical linked-list node */}
                    <span
                      class:list={[
                        'chapter-node-dot absolute -left-[25px] top-3.5 h-2.5 w-2.5 rounded-full border-[1.5px]',
                        hasNotes
                          ? 'border-[var(--text)] bg-[var(--text)]'
                          : 'border-[var(--text-muted)] bg-[var(--bg)]',
                      ]}
                    />

                    <summary class="chapter-node flex cursor-pointer list-none items-center justify-between gap-2 rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-3">
                      <div class="min-w-0">
                        <div class="flex items-center gap-2">
                          <span class="font-mono text-[11px] text-[var(--text-muted)]">
                            {String(chapter.order).padStart(2, '0')}
                          </span>
                          <span class="truncate font-editorial text-sm font-semibold text-[var(--text)]">
                            {chapter.title}
                          </span>
                        </div>
                        {chapter.textbookRef && (
                          <div class="mt-0.5 text-[11px] text-[var(--text-muted)]">
                            {chapter.textbookRef}
                          </div>
                        )}
                      </div>
                      <span class="flex shrink-0 items-center gap-1.5 font-mono text-[11px] text-[var(--text-muted)]">
                        {publishedCount}/{totalCount}
                        <span aria-hidden="true" class="chapter-chevron inline-block">▸</span>
                      </span>
                    </summary>

                    <div class="mt-2 space-y-3 rounded-xl border border-[var(--border)] bg-[var(--surface)]/60 p-3.5">
                      {chapter.sections.map((section) => (
                        <div>
                          <div class="mb-1 text-[11px] font-medium text-[var(--text-muted)]">
                            {section.title}
                          </div>
                          <ul class="space-y-1">
                            {section.topics.map((stub) => {
                              const resolved = index.topicsById.get(stub.id);
                              const isPublished = resolved?.isPublished ?? false;
                              const status = resolved?.status ?? '未开始';
                              return (
                                <li>
                                  <a
                                    href={`/kb/${stub.id}`}
                                    class:list={[
                                      'flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 text-xs',
                                      isPublished
                                        ? 'bg-[var(--surface-subtle)] font-medium text-[var(--text)]'
                                        : 'text-[var(--text-muted)]',
                                    ]}
                                  >
                                    <span class="flex items-center gap-2 min-w-0">
                                      <StudyStatusBadge status={status} compact />
                                      <span class="truncate">{resolved?.title ?? stub.title}</span>
                                    </span>
                                    {stub.viz && (
                                      <span class="shrink-0 rounded border border-[var(--border)] px-1 py-0.5 font-mono text-[9px] uppercase text-[var(--text-muted)]">
                                        {stub.viz}
                                      </span>
                                    )}
                                  </a>
                                </li>
                              );
                            })}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </details>
                );
              })}
            </div>
          </section>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .chapter-node:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .chapter-disclosure[open] .chapter-chevron {
    transform: rotate(90deg);
  }

  @media (hover: hover) and (pointer: fine) {
    .chapter-node:hover {
      border-color: var(--primary);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .chapter-node {
      transition: transform 150ms var(--ease-out), border-color 150ms ease, color 150ms ease, background-color 150ms ease;
    }

    .chapter-node-dot, .chapter-chevron {
      transition: transform 150ms var(--ease-out), background-color 150ms ease, border-color 150ms ease;
    }

    @media (hover: hover) and (pointer: fine) {
      .chapter-node:not([data-active="true"]):hover { transform: translateY(-2px); }
      .chapter-node:hover .chapter-node-dot,
      .chapter-disclosure:has(> summary:hover) > .chapter-node-dot {
        transform: scale(1.25);
      }
    }

    .chapter-node:active { transform: translateY(1px); }
    .chapter-node:active .chapter-node-dot,
    .chapter-disclosure:has(> summary:active) > .chapter-node-dot {
      transform: scale(0.85);
    }
  }
</style>

<script is:inline>
  (() => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1. Animate horizontal gradient course progress bars on viewport entry
    function animateCourseBar(el) {
      if (el.getAttribute('data-animated') === 'true') return;
      el.setAttribute('data-animated', 'true');

      const primaryPct = Number(el.getAttribute('data-primary-width') || '0');
      const secondaryPct = Number(el.getAttribute('data-secondary-width') || '0');
      const primaryEl = el.querySelector('[data-bar-primary]');
      const secondaryEl = el.querySelector('[data-bar-secondary]');

      const applyWidths = () => {
        if (primaryEl) primaryEl.style.width = `${primaryPct}%`;
        if (secondaryEl) secondaryEl.style.width = `${secondaryPct}%`;
      };

      if (reduceMotion) {
        applyWidths();
      } else {
        requestAnimationFrame(() => requestAnimationFrame(applyWidths));
      }
    }

    const courseBars = document.querySelectorAll('[data-course-progress]');
    if (courseBars.length) {
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                animateCourseBar(entry.target);
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 },
        );
        courseBars.forEach((bar) => io.observe(bar));
      } else {
        courseBars.forEach((bar) => animateCourseBar(bar));
      }
    }

    // 2. Smooth linked-list chapter tab switching, sliding indicator, click-to-center & drag/wheel scrolling
    document.querySelectorAll('[data-course-section]').forEach((section) => {
      const wrapper = section.querySelector('[data-linked-list-wrapper]');
      const bar = wrapper?.querySelector('[data-linked-list-bar]');
      const indicator = bar?.querySelector('[data-active-indicator]');
      const prevBtn = wrapper?.querySelector('[data-scroll-prev]');
      const nextBtn = wrapper?.querySelector('[data-scroll-next]');
      const tabs = Array.from(section.querySelectorAll('[data-chapter-tab]'));
      const panels = Array.from(section.querySelectorAll('[data-chapter-panel]'));

      if (!bar || !tabs.length) return;

      let activeIndex = 0;

      function positionIndicator(targetTab, instant = false) {
        if (!indicator || !targetTab) return;
        const barRect = bar.getBoundingClientRect();
        const btnRect = targetTab.getBoundingClientRect();
        if (barRect.width === 0 || btnRect.width === 0) return;

        const left = btnRect.left - barRect.left + bar.scrollLeft;
        const width = btnRect.width;
        const height = btnRect.height;

        if (instant || reduceMotion) {
          const prevTransition = indicator.style.transition;
          indicator.style.transition = 'none';
          indicator.style.transform = `translate3d(${left}px, -50%, 0)`;
          indicator.style.width = `${width}px`;
          indicator.style.height = `${height}px`;
          indicator.style.opacity = '1';
          // Force reflow then restore transition
          void indicator.offsetWidth;
          indicator.style.transition = prevTransition;
        } else {
          indicator.style.transform = `translate3d(${left}px, -50%, 0)`;
          indicator.style.width = `${width}px`;
          indicator.style.height = `${height}px`;
          indicator.style.opacity = '1';
        }
      }

      function styleTabs(activeChapterId, usePillBackdrop) {
        tabs.forEach((tab) => {
          const active = tab.getAttribute('data-chapter-tab') === activeChapterId;
          tab.setAttribute('data-active', String(active));
          tab.setAttribute('aria-pressed', String(active));

          // When the sliding indicator pill is active, make active button background transparent so the gliding pill shows through
          tab.classList.toggle('border-transparent', active && usePillBackdrop);
          tab.classList.toggle('bg-transparent', active && usePillBackdrop);
          tab.classList.toggle('border-primary', active && !usePillBackdrop);
          tab.classList.toggle('bg-primary', active && !usePillBackdrop);
          tab.classList.toggle('text-primary-foreground', active);
          tab.classList.toggle('shadow-xs', active && !usePillBackdrop);

          tab.classList.toggle('border-border', !active);
          tab.classList.toggle('bg-card/80', !active);
          tab.classList.toggle('text-foreground', !active);

          const dot = tab.querySelector('span[title]');
          if (dot) {
            const hasNotes = !dot.getAttribute('title')?.includes('暂未记入');
            dot.classList.toggle('border-primary-foreground', active);
            dot.classList.toggle('bg-primary-foreground', active && hasNotes);
            dot.classList.toggle('border-primary', !active && hasNotes);
            dot.classList.toggle('bg-primary', !active && hasNotes);
            dot.classList.toggle('border-muted-foreground', !active && !hasNotes);
          }
        });
      }

      function centerTabInBar(targetTab) {
        const barRect = bar.getBoundingClientRect();
        const btnRect = targetTab.getBoundingClientRect();
        if (barRect.width === 0 || btnRect.width === 0) return;

        const targetScrollLeft =
          bar.scrollLeft + (btnRect.left - barRect.left) - (barRect.width - btnRect.width) / 2;
        const maxScroll = Math.max(0, bar.scrollWidth - bar.clientWidth);
        const clamped = Math.max(0, Math.min(maxScroll, targetScrollLeft));

        bar.scrollTo({
          left: clamped,
          behavior: reduceMotion ? 'auto' : 'smooth',
        });
      }

      // Initialize pill position on first visible render
      function initIndicator() {
        const currentTab = tabs[activeIndex];
        if (!currentTab) return;
        const barRect = bar.getBoundingClientRect();
        if (barRect.width > 0) {
          styleTabs(currentTab.getAttribute('data-chapter-tab') || '', true);
          positionIndicator(currentTab, true);
        }
      }

      initIndicator();
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(() => {
          const currentTab = tabs[activeIndex];
          if (currentTab) positionIndicator(currentTab, true);
        });
      }

      tabs.forEach((btn, idx) => {
        btn.addEventListener('click', () => {
          const chapterId = btn.getAttribute('data-chapter-tab');
          if (!chapterId) return;

          const prevIndex = activeIndex;
          activeIndex = idx;

          styleTabs(chapterId, true);
          positionIndicator(btn, false);
          centerTabInBar(btn);

          const enterClass =
            idx >= prevIndex ? 'animate-chapter-enter-right' : 'animate-chapter-enter-left';

          panels.forEach((panel) => {
            const active = panel.getAttribute('data-chapter-panel') === chapterId;
            panel.classList.remove('animate-chapter-enter-right', 'animate-chapter-enter-left');
            panel.classList.toggle('hidden', !active);
            panel.classList.toggle('block', active);
            if (active && idx !== prevIndex && !reduceMotion) {
              // Trigger CSS keyframe animation cleanly on switch
              void panel.offsetWidth;
              panel.classList.add(enterClass);
            }
          });
        });
      });

      // Scroll arrows, wheel-to-horizontal & drag-to-scroll
      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;
      let dragged = false;

      function updateArrows() {
        const hasOverflow = bar.scrollWidth > bar.clientWidth + 2;
        if (prevBtn instanceof HTMLButtonElement) {
          prevBtn.disabled = !hasOverflow || bar.scrollLeft <= 2;
        }
        if (nextBtn instanceof HTMLButtonElement) {
          nextBtn.disabled =
            !hasOverflow || bar.scrollLeft + bar.clientWidth >= bar.scrollWidth - 2;
        }
      }

      prevBtn?.addEventListener('click', () => {
        bar.scrollBy({ left: -260, behavior: 'smooth' });
      });

      nextBtn?.addEventListener('click', () => {
        bar.scrollBy({ left: 260, behavior: 'smooth' });
      });

      bar.addEventListener('scroll', updateArrows, { passive: true });
      window.addEventListener(
        'resize',
        () => {
          updateArrows();
          initIndicator();
        },
        { passive: true },
      );
      updateArrows();

      bar.addEventListener(
        'wheel',
        (e) => {
          if (bar.scrollWidth <= bar.clientWidth) return;
          const delta = Math.abs(e.deltaY) >= Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
          if (delta === 0) return;
          const atStart = bar.scrollLeft <= 0 && delta < 0;
          const atEnd = bar.scrollLeft + bar.clientWidth >= bar.scrollWidth - 1 && delta > 0;
          if (!atStart && !atEnd) {
            e.preventDefault();
            bar.scrollLeft += delta;
          }
        },
        { passive: false },
      );

      bar.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return;
        isDown = true;
        dragged = false;
        startX = e.pageX - bar.offsetLeft;
        scrollLeft = bar.scrollLeft;
        bar.classList.add('cursor-grabbing');
      });

      window.addEventListener('mouseup', () => {
        isDown = false;
        bar.classList.remove('cursor-grabbing');
      });

      bar.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        const x = e.pageX - bar.offsetLeft;
        const walk = x - startX;
        if (Math.abs(walk) > 6) dragged = true;
        bar.scrollLeft = scrollLeft - walk;
      });

      bar.addEventListener(
        'click',
        (e) => {
          if (dragged) {
            e.preventDefault();
            e.stopPropagation();
            dragged = false;
          }
        },
        true,
      );
    });
  })();
</script>
