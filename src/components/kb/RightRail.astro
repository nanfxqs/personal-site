---
import type { MarkdownHeading } from 'astro';
import { getKnowledgeIndex, type ResolvedTopic } from '@/lib/kb-graph';
import { badgeVariants } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';

interface Props {
  topic: ResolvedTopic;
  headings?: MarkdownHeading[];
}

const { topic, headings = [] } = Astro.props;
const index = await getKnowledgeIndex();
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const prereqTopics = topic.prerequisites
  .map((id) => index.topicsById.get(id))
  .filter((t): t is ResolvedTopic => Boolean(t));

const relatedTopics = topic.related
  .map((id) => index.topicsById.get(id))
  .filter((t): t is ResolvedTopic => Boolean(t));
---

<div class="space-y-6 text-xs">
  {
    tocHeadings.length > 0 && (
      <div>
        <h3 class="mb-2.5 font-sans text-[11px] font-semibold tracking-wider uppercase text-muted-foreground">
          本页目录
        </h3>
        <ul class="space-y-1 border-l border-border pl-3">
          {tocHeadings.map((h) => (
            <li class={h.depth === 3 ? 'pl-2.5' : ''}>
              <a
                href={`#${h.slug}`}
                class="block rounded-md py-1 leading-snug text-muted-foreground hover:text-foreground transition-colors"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    prereqTopics.length > 0 && (
      <div>
        <h3 class="mb-2.5 font-sans text-[11px] font-semibold tracking-wider uppercase text-muted-foreground">
          前置知识
        </h3>
        <ul class="space-y-1.5">
          {prereqTopics.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex items-center justify-between gap-2 rounded-xl border border-border bg-card px-3 py-2 shadow-2xs transition-all hover:border-foreground/25 hover:bg-accent/50"
              >
                <span class="truncate font-medium text-foreground">{item.title}</span>
                <span class={cn(badgeVariants({ variant: 'muted' }), 'shrink-0 px-1.5 py-0 text-[10px]')}>
                  {item.courseShortTitle}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    relatedTopics.length > 0 && (
      <div>
        <h3 class="mb-2.5 font-sans text-[11px] font-semibold tracking-wider uppercase text-muted-foreground">
          跨科 / 关联知识点
        </h3>
        <ul class="space-y-1.5">
          {relatedTopics.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex items-center justify-between gap-2 rounded-xl border border-border bg-card px-3 py-2 shadow-2xs transition-all hover:border-foreground/25 hover:bg-accent/50"
              >
                <span class="truncate font-medium text-foreground">{item.title}</span>
                <span class={cn(badgeVariants({ variant: 'muted' }), 'shrink-0 px-1.5 py-0 text-[10px]')}>
                  {item.courseShortTitle}
                  {!item.isPublished && ' · 待学'}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    topic.backlinks.length > 0 && (
      <div>
        <div class="mb-2.5 flex items-center justify-between">
          <h3 class="font-sans text-[11px] font-semibold tracking-wider uppercase text-muted-foreground">
            反向引用
          </h3>
          <span class={cn(badgeVariants({ variant: 'outline' }), 'font-mono text-[10px] px-1.5 py-0')}>
            {topic.backlinks.length}
          </span>
        </div>
        <ul class="space-y-1.5">
          {topic.backlinks.map((bl) => (
            <li>
              <a
                href={bl.href}
                class="block rounded-xl border border-border bg-muted/40 px-3 py-2 transition-all hover:border-foreground/25 hover:bg-accent/60"
              >
                <div class="truncate font-medium text-foreground">{bl.title}</div>
                {bl.meta && (
                  <div class="mt-0.5 text-[10px] text-muted-foreground">{bl.meta}</div>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <div class="border-t border-border pt-4">
    <a
      href="/graph"
      class={cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'w-full justify-between rounded-xl')}
    >
      <span>查看全局知识图谱</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</div>
