---
import { getKnowledgeIndex } from '@/lib/kb-graph';

interface Props {
  id: string;
  label?: string;
}

const { id, label } = Astro.props;
const index = await getKnowledgeIndex();
const target = index.topicsById.get(id);
const display = label ?? target?.title ?? id;
const isPublished = target?.isPublished ?? false;
const href = target?.href ?? `/kb/${id}`;
---

<a
  href={href}
  title={
    target
      ? `${target.courseShortTitle} · ${target.chapterTitle} (${target.isPublished ? target.status : '待学占位节点'})`
      : `知识点：${id}`
  }
  class:list={[
    'inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 text-[0.92em] no-underline transition-colors',
    isPublished
      ? 'border border-[var(--border)] bg-[var(--surface-subtle)] font-medium text-[var(--text)] hover:border-[var(--text)]'
      : 'border border-dashed border-[var(--border)] bg-[var(--surface)] text-[var(--text-muted)] hover:border-[var(--text)] hover:text-[var(--text)]',
  ]}
>
  <span>{display}</span>
  {!isPublished && <span class="text-[10px]">待学</span>}
</a>
