---
import { SYLLABI, type SubjectId } from '@/data/syllabus';
import { getKnowledgeIndex } from '@/lib/kb-graph';
import { buttonVariants } from '@/components/ui/button';
import { badgeVariants } from '@/components/ui/badge';
import { cn } from '@/lib/utils';
import StudyStatusBadge from './StudyStatusBadge.astro';

interface Props {
  subjectId: SubjectId;
  activeCourseId: string;
  activeTopicId?: string;
}

const { subjectId, activeCourseId, activeTopicId } = Astro.props;
const subject = SYLLABI[subjectId];
const activeCourse =
  subject.courses.find((c) => c.id === activeCourseId) ?? subject.courses[0];
const index = await getKnowledgeIndex();
---

<div class="space-y-5">
  <!-- Subject header -->
  <div>
    <a
      href={`/kb/${subject.id}`}
      class="inline-flex items-center gap-1.5 text-[11px] font-mono font-medium tracking-wider uppercase text-muted-foreground hover:text-foreground transition-colors"
    >
      <span>{subject.title}</span>
    </a>
  </div>

  <!-- Course switcher pills -->
  <div class="flex flex-wrap gap-1.5">
    {
      subject.courses.map((course) => {
        const firstTopic = course.chapters[0]?.sections[0]?.topics[0];
        const href = firstTopic ? `/kb/${firstTopic.id}` : `/kb/${subject.id}`;
        const isCurrent = course.id === activeCourse.id;
        return (
          <a
            href={href}
            class={cn(
              buttonVariants({ variant: isCurrent ? 'default' : 'outline', size: 'xs' }),
              'h-7 rounded-lg px-2.5 text-[11px]',
            )}
          >
            {course.shortTitle}
          </a>
        );
      })
    }
  </div>

  <!-- Chapter -> Section -> Topic tree -->
  <nav aria-label="章节目录" class="space-y-3.5">
    {
      activeCourse.chapters.map((chapter) => {
        const containsActive = chapter.sections.some((sec) =>
          sec.topics.some((t) => t.id === activeTopicId),
        );
        return (
          <details open={containsActive || chapter.order <= 2} class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-lg px-1.5 py-1.5 text-xs font-semibold tracking-wide text-foreground hover:bg-accent/70 transition-colors">
              <span class="truncate">
                <span class="mr-1.5 font-mono text-[11px] text-muted-foreground">
                  {String(chapter.order).padStart(2, '0')}
                </span>
                {chapter.title}
              </span>
              <span class="text-[10px] text-muted-foreground transition-transform duration-200 group-open:rotate-90">
                ▸
              </span>
            </summary>

            <div class="mt-1.5 ml-2 space-y-2.5 border-l border-border pl-3">
              {chapter.sections.map((section) => (
                <div>
                  <div class="mb-1 px-1 text-[11px] font-medium text-muted-foreground">
                    {section.title}
                  </div>
                  <ul class="space-y-0.5">
                    {section.topics.map((stub) => {
                      const resolved = index.topicsById.get(stub.id);
                      const isCurrent = stub.id === activeTopicId;
                      const isPublished = resolved?.isPublished ?? false;
                      const status = resolved?.status ?? '未开始';
                      return (
                        <li>
                          <a
                            href={`/kb/${stub.id}`}
                            class={cn(
                              'flex items-center gap-2 rounded-lg px-2 py-1.5 text-xs leading-snug transition-colors',
                              isCurrent
                                ? 'bg-secondary font-medium text-foreground shadow-2xs'
                                : isPublished
                                  ? 'text-foreground hover:bg-accent/70'
                                  : 'text-muted-foreground hover:bg-accent/60 hover:text-foreground',
                            )}
                          >
                            <StudyStatusBadge status={status} compact />
                            <span class="flex-1 truncate">{resolved?.title ?? stub.title}</span>
                            {stub.viz && (
                              <span
                                class={cn(
                                  badgeVariants({ variant: 'muted' }),
                                  'shrink-0 rounded-md px-1.5 py-0 font-mono text-[9px] uppercase',
                                )}
                              >
                                {stub.viz}
                              </span>
                            )}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        );
      })
    }
  </nav>
</div>
