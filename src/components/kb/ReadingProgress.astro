---
---
<button
  id="reading-progress-btn"
  type="button"
  aria-label="阅读进度（可拖拽移动，点击返回顶部）"
  title="可拖拽移动位置 · 点击返回顶部"
  class="glass-surface-strong fixed bottom-6 z-40 flex h-14 w-14 touch-none select-none items-center justify-center rounded-full transition-[border-color,box-shadow] duration-200 hover:border-[var(--specular-border)] cursor-grab active:cursor-grabbing"
>
  <svg class="h-14 w-14 -rotate-90 pointer-events-none" viewBox="0 0 56 56" aria-hidden="true">
    <defs>
      <linearGradient id="mono-ring-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#7dd3fc" />
        <stop offset="55%" stop-color="var(--subject-408)" />
        <stop offset="100%" stop-color="var(--subject-math1)" />
      </linearGradient>
    </defs>
    <circle
      cx="28"
      cy="28"
      r="22"
      fill="none"
      stroke="var(--border)"
      stroke-width="2"
    />
    <circle
      id="reading-progress-arc"
      cx="28"
      cy="28"
      r="22"
      fill="none"
      stroke="url(#mono-ring-grad)"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-dasharray="138.23"
      stroke-dashoffset="138.23"
    />
  </svg>
  <div class="pointer-events-none absolute flex flex-col items-center leading-none">
    <span
      id="reading-progress-text"
      class="font-mono text-[11px] font-semibold text-[var(--text)]"
    >
      0%
    </span>
    <span class="mt-0.5 text-[8px] text-[var(--text-muted)]">TOP</span>
  </div>
</button>

<style>
  #reading-progress-btn {
    right: clamp(
      12px,
      calc(var(--reading-progress-right, 24px) + var(--reading-progress-drag-x, 0px)),
      max(12px, calc(100% - 3.5rem - 12px))
    );
  }
</style>

<script is:inline>
  (() => {
    const btn = document.getElementById('reading-progress-btn');
    const arc = document.getElementById('reading-progress-arc');
    const label = document.getElementById('reading-progress-text');
    const anchor = document.querySelector('[data-reading-progress-anchor]');
    if (!btn || !arc || !label) return;

    const circumference = 2 * Math.PI * 22;

    function updateAnchor() {
      if (!anchor) return;
      const right = document.documentElement.clientWidth - anchor.getBoundingClientRect().right + 12;
      btn.style.setProperty('--reading-progress-right', `${right}px`);
    }

    if (anchor) {
      new ResizeObserver(updateAnchor).observe(anchor);
      window.addEventListener('resize', updateAnchor, { passive: true });
      updateAnchor();
    }

    function updateProgress() {
      const doc = document.documentElement;
      const maxScroll = Math.max(1, doc.scrollHeight - window.innerHeight);
      const ratio = Math.min(1, Math.max(0, window.scrollY / maxScroll));
      const pct = Math.round(ratio * 100);
      arc.style.strokeDashoffset = String(circumference * (1 - ratio));
      label.textContent = `${pct}%`;
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress, { passive: true });
    updateProgress();

    // Pointer-based drag + click-to-top discrimination
    let dragPointerId = null;
    let moved = false;
    let startX = 0;
    let startY = 0;
    let origLeft = 0;
    let origTop = 0;

    btn.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || dragPointerId !== null) return;
      dragPointerId = e.pointerId;
      moved = false;
      const rect = btn.getBoundingClientRect();
      startX = e.clientX;
      startY = e.clientY;
      origLeft = rect.left;
      origTop = rect.top;
      btn.setPointerCapture(e.pointerId);
    });

    btn.addEventListener('pointermove', (e) => {
      if (e.pointerId !== dragPointerId) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.hypot(dx, dy) > 5) moved = true;
      if (!moved) return;

      const margin = 12;
      const viewportWidth = document.documentElement.clientWidth;
      const maxLeft = viewportWidth - btn.offsetWidth - margin;
      const maxTop = window.innerHeight - btn.offsetHeight - margin;
      const nextLeft = Math.min(maxLeft, Math.max(margin, origLeft + dx));
      const nextTop = Math.min(maxTop, Math.max(margin, origTop + dy));

      const anchorRight = Number.parseFloat(btn.style.getPropertyValue('--reading-progress-right')) || 24;
      btn.style.setProperty('--reading-progress-drag-x', `${viewportWidth - btn.offsetWidth - nextLeft - anchorRight}px`);
      btn.style.bottom = 'auto';
      btn.style.top = `${nextTop}px`;
    });

    btn.addEventListener('lostpointercapture', (e) => {
      if (e.pointerId === dragPointerId) dragPointerId = null;
    });

    btn.addEventListener('click', (e) => {
      if (moved && e.detail > 0) return;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reducedMotion ? 'instant' : 'smooth' });
    });
  })();
</script>
