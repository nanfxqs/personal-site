---
import type { StudyStatus } from '@/data/syllabus';
import { badgeVariants } from '@/components/ui/badge';

interface Props {
  status: StudyStatus;
  compact?: boolean;
}

const { status, compact = false } = Astro.props;

const variantMap: Record<StudyStatus, 'success' | 'warning' | 'muted'> = {
  已掌握: 'success',
  学习中: 'warning',
  未开始: 'muted',
};

const dotStyles: Record<StudyStatus, string> = {
  已掌握: 'bg-emerald-500',
  学习中: 'bg-amber-500',
  未开始: 'bg-muted-foreground/35',
};
---

{
  compact ? (
    <span
      title={`学习状态：${status}`}
      class:list={['inline-block h-2 w-2 shrink-0 rounded-full', dotStyles[status]]}
    />
  ) : (
    <span class={badgeVariants({ variant: variantMap[status] })}>
      <span class:list={['h-1.5 w-1.5 rounded-full', dotStyles[status]]} />
      {status}
    </span>
  )
}
