---
import { SITE } from '@/config/site';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}

const subjectLinks = [
  {
    label: '408',
    subtitle: '数据结构 · 计组 · OS · 计网',
    href: '/kb/408',
    dot: 'bg-[var(--subject-408)]',
    glow: 'shadow-[0_0_8px_color-mix(in_srgb,var(--subject-408)_55%,transparent)]',
  },
  {
    label: '数学一',
    subtitle: '高数 · 线代 · 概率论',
    href: '/kb/math1',
    dot: 'bg-[var(--subject-math1)]',
    glow: 'shadow-[0_0_8px_color-mix(in_srgb,var(--subject-math1)_55%,transparent)]',
  },
  {
    label: '英语一',
    subtitle: '词句地基 · 五大题型',
    href: '/kb/english1',
    dot: 'bg-[var(--subject-english1)]',
    glow: 'shadow-[0_0_8px_color-mix(in_srgb,var(--subject-english1)_55%,transparent)]',
  },
];
const activeSubject = subjectLinks.find(({ href }) => isActive(href));
const isKbOverview = currentPath === '/kb' || currentPath === '/kb/';
---

<header
  class="site-nav sticky top-0 z-40 border-b border-border/70 bg-background/72 backdrop-blur-xl backdrop-saturate-150 shadow-[inset_0_-1px_0_rgba(255,255,255,0.22)] dark:shadow-[inset_0_-1px_0_rgba(186,230,253,0.06)]"
>
  <div class="mx-auto flex h-15 max-w-7xl items-center gap-2 px-2 sm:px-6 md:justify-between md:gap-4 lg:px-8">
    <a
      href="/"
      class="hidden items-center gap-2 rounded-md font-editorial text-xl tracking-tight text-foreground transition-opacity hover:opacity-80 md:flex"
    >
      <span class="inline-block h-2 w-2 rounded-full bg-primary" aria-hidden="true"></span>
      <span class="italic">{SITE.nickname}.</span>
    </a>

    <nav data-main-nav aria-label="主导航" class="no-scrollbar flex min-w-0 flex-1 items-center gap-1 overflow-x-auto overscroll-x-contain whitespace-nowrap px-0.5 py-2 md:flex-none">
      <a
        href="/"
        aria-current={isActive('/') ? 'page' : undefined}
        class={cn(
          buttonVariants({ variant: isActive('/') ? 'secondary' : 'ghost', size: 'sm' }),
          'shrink-0 rounded-full text-xs md:text-[13px]',
          isActive('/') && 'font-semibold text-secondary-foreground',
        )}
      >
        首页
      </a>
      <a
        href="/journal"
        aria-current={isActive('/journal') ? 'page' : undefined}
        class={cn(
          buttonVariants({ variant: isActive('/journal') ? 'secondary' : 'ghost', size: 'sm' }),
          'shrink-0 rounded-full text-xs md:text-[13px]',
          isActive('/journal') && 'font-semibold text-secondary-foreground',
        )}
      >
        日常
      </a>

      <button
        id="subject-nav-trigger"
        type="button"
        popovertarget="subject-nav-menu"
        aria-controls="subject-nav-menu"
        aria-expanded="false"
        data-current={activeSubject ? 'true' : undefined}
        class={cn(
          buttonVariants({ variant: activeSubject ? 'secondary' : 'ghost', size: 'sm' }),
          'subject-trigger shrink-0 gap-1.5 rounded-full text-xs md:text-[13px]',
        )}
      >
        {activeSubject && (
          <span class={cn('h-1.5 w-1.5 rounded-full', activeSubject.dot)} aria-hidden="true" />
        )}
        <span>{activeSubject ? `学科 · ${activeSubject.label}` : '学科'}</span>
        <svg
          class="subject-chevron size-3.5 opacity-75"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </button>
      <div
        id="subject-nav-menu"
        popover
        role="group"
        aria-label="选择学科"
        class="subject-popover glass-surface-strong fixed inset-auto m-0 w-60 max-w-[calc(100vw-1rem)] overflow-y-auto rounded-2xl p-1.5 text-popover-foreground"
      >
        <ul class="space-y-0.5">
          {
            subjectLinks.map((link) => {
              const active = isActive(link.href);
              return (
                <li>
                  <a
                    href={link.href}
                    aria-current={active ? 'location' : undefined}
                    class={cn(
                      'subject-menu-item group flex min-h-11 items-center gap-3 rounded-[10px] px-2.5 py-2 transition-[background-color,color,box-shadow] duration-150 ease-[var(--ease-out)] focus-visible:outline-2 focus-visible:outline-primary',
                      active
                        ? 'bg-secondary/90 text-secondary-foreground shadow-[inset_0_0_0_1px_var(--specular-border)]'
                        : 'text-foreground/90 hover:bg-accent/70 hover:text-accent-foreground',
                    )}
                  >
                    <span
                      class={cn(
                        'h-2 w-2 shrink-0 rounded-full',
                        link.dot,
                        link.glow,
                      )}
                      aria-hidden="true"
                    />
                    <span class="min-w-0 flex-1">
                      <span class={cn('block text-[13px] leading-tight', active ? 'font-semibold' : 'font-medium')}>
                        {link.label}
                      </span>
                      <span
                        class={cn(
                          'mt-0.5 block truncate text-[11px] leading-tight',
                          active ? 'text-secondary-foreground/75' : 'text-muted-foreground',
                        )}
                      >
                        {link.subtitle}
                      </span>
                    </span>
                    {active ? (
                      <svg
                        class="size-3.5 shrink-0 text-primary"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                    ) : (
                      <svg
                        class="subject-menu-arrow size-3.5 shrink-0 text-muted-foreground/65 opacity-60 transition-[transform,opacity,color] duration-150 ease-[var(--ease-out)]"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="m9 18 6-6-6-6" />
                      </svg>
                    )}
                  </a>
                </li>
              );
            })
          }
        </ul>
        <div class="mt-1 border-t border-border/60 pt-1">
          <a
            href="/kb"
            aria-current={isKbOverview ? 'page' : undefined}
            class={cn(
              'subject-menu-item group flex min-h-8 items-center justify-between rounded-[10px] px-2.5 py-1.5 text-xs font-medium transition-[background-color,color] duration-150 ease-[var(--ease-out)] focus-visible:outline-2 focus-visible:outline-primary',
              isKbOverview
                ? 'bg-secondary/90 text-secondary-foreground'
                : 'text-muted-foreground hover:bg-accent/70 hover:text-foreground',
            )}
          >
            <span>知识库总览</span>
            <svg
              class="subject-menu-arrow size-3 text-muted-foreground/70 opacity-65 transition-[transform,opacity] duration-150 ease-[var(--ease-out)]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

      <a
        href="/graph"
        aria-current={isActive('/graph') ? 'page' : undefined}
        class={cn(
          buttonVariants({ variant: isActive('/graph') ? 'secondary' : 'ghost', size: 'sm' }),
          'shrink-0 rounded-full text-xs md:text-[13px]',
          isActive('/graph') && 'font-semibold text-secondary-foreground',
        )}
      >
        <span class="hidden md:inline">知识图谱</span><span class="md:hidden">图谱</span>
      </a>
    </nav>

    <div class="flex shrink-0 items-center gap-1.5 border-l border-border/60 pl-2 md:gap-2 md:border-0 md:pl-0">
      <button
        type="button"
        data-open-search
        aria-label="搜索"
        class={cn(
          buttonVariants({ variant: 'outline', size: 'sm' }),
          'relative size-8 rounded-full bg-card/75 p-0 text-muted-foreground backdrop-blur-md hover:text-foreground max-md:before:absolute max-md:before:-inset-y-1.5 max-md:before:-inset-x-0.5 max-md:before:content-[""] md:w-auto md:px-3',
        )}
      >
        <svg
          class="h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <span class="hidden text-xs md:inline">搜索</span>
        <kbd class="hidden h-5 items-center rounded border border-border bg-muted/80 px-1.5 font-mono text-[10px] font-medium text-muted-foreground md:inline-flex">
          ⌘K
        </kbd>
      </button>
      <ThemeToggle />
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const nav = document.querySelector('[data-main-nav]');
    const trigger = document.getElementById('subject-nav-trigger');
    const menu = document.getElementById('subject-nav-menu');
    if (!nav || !trigger || !menu) return;

    function positionMenu() {
      const triggerBounds = trigger.getBoundingClientRect();
      const navBounds = nav.getBoundingClientRect();
      const menuWidth = menu.offsetWidth || 240;
      const top = triggerBounds.bottom + 6;
      const left = Math.min(
        Math.max(8, triggerBounds.left, navBounds.left),
        document.documentElement.clientWidth - menuWidth - 8,
      );
      const originX = Math.max(
        16,
        Math.min(menuWidth - 16, triggerBounds.left + triggerBounds.width / 2 - left),
      );
      menu.style.left = `${left}px`;
      menu.style.top = `${top}px`;
      menu.style.maxHeight = `${Math.max(0, window.innerHeight - top - 8)}px`;
      menu.style.setProperty('--popover-origin-x', `${Math.round(originX)}px`);
    }

    function syncPosition() {
      if (!menu.matches(':popover-open')) return;
      const triggerBounds = trigger.getBoundingClientRect();
      const navBounds = nav.getBoundingClientRect();
      if (triggerBounds.right <= navBounds.left || triggerBounds.left >= navBounds.right) {
        menu.hidePopover();
      } else {
        positionMenu();
      }
    }

    menu.addEventListener('toggle', (event) => {
      const open = event.newState === 'open';
      trigger.setAttribute('aria-expanded', String(open));
      if (open) syncPosition();
    });
    menu.addEventListener('beforetoggle', (event) => {
      if (event.newState === 'open') {
        positionMenu();
      }
    });
    document.addEventListener('focusin', (event) => {
      if (event.target !== trigger && !menu.contains(event.target) && menu.matches(':popover-open')) {
        menu.hidePopover();
      }
    });
    function closeMenu() {
      if (menu.matches(':popover-open')) menu.hidePopover();
    }

    nav.addEventListener('click', (event) => {
      if (event.target.closest('a') && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey) {
        closeMenu();
      }
    });
    window.addEventListener('pagehide', closeMenu);
    nav.addEventListener('scroll', syncPosition, { passive: true });
    window.addEventListener('resize', syncPosition, { passive: true });

    const active = nav.querySelector(':scope > [aria-current], :scope > [data-current]');
    if (active) {
      const overflow = active.getBoundingClientRect().right - nav.getBoundingClientRect().right;
      if (overflow > 0) nav.scrollLeft += overflow + 8;
    }
  })();
</script>

<style>
  .subject-trigger .subject-chevron {
    transition: transform 200ms var(--ease-out), opacity 180ms ease;
  }

  .subject-trigger[aria-expanded='true'] {
    background-color: var(--accent-surface);
    color: var(--accent-foreground);
    box-shadow: inset 0 0 0 1px var(--specular-border);
  }

  .subject-trigger[data-current='true'][aria-expanded='true'] {
    background-color: var(--secondary);
    color: var(--secondary-foreground);
  }

  .subject-trigger[aria-expanded='true'] .subject-chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  .subject-popover {
    transform-origin: var(--popover-origin-x, 2.5rem) top;
    box-shadow: var(--glass-inset), var(--glass-shadow-hover);
    opacity: 0;
    transform: translateY(-6px) scale(0.96);
    transition:
      opacity 150ms var(--ease-out),
      transform 160ms var(--ease-out),
      display 160ms allow-discrete,
      overlay 160ms allow-discrete;
  }

  .subject-popover:popover-open {
    opacity: 1;
    transform: translateY(0) scale(1);
    transition:
      opacity 180ms var(--ease-out),
      transform 200ms var(--ease-out),
      display 200ms allow-discrete,
      overlay 200ms allow-discrete;
  }

  @starting-style {
    .subject-popover:popover-open {
      opacity: 0;
      transform: translateY(-6px) scale(0.96);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .subject-menu-item:hover .subject-menu-arrow {
      transform: translateX(2px);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .subject-trigger .subject-chevron {
      transition: none;
    }

    .subject-popover,
    .subject-popover:popover-open {
      transform: none;
      transition:
        opacity 120ms ease,
        display 120ms allow-discrete,
        overlay 120ms allow-discrete;
    }

    @starting-style {
      .subject-popover:popover-open {
        opacity: 0;
        transform: none;
      }
    }

    .subject-menu-item .subject-menu-arrow {
      transition: opacity 120ms ease;
    }
  }
</style>
