---
import { NAV_LINKS, SITE } from '@/config/site';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header
  class="sticky top-0 z-40 border-b border-[var(--border)] bg-[var(--bg)]/85 backdrop-blur-md"
>
  <div class="mx-auto flex h-15 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a
      href="/"
      class="flex items-baseline gap-2 font-editorial text-xl font-semibold tracking-tight text-[var(--text)] hover:text-[var(--accent)] transition-colors"
    >
      <span class="italic">{SITE.nickname}.</span>
      <span class="hidden text-xs font-sans font-normal text-[var(--text-muted)] sm:inline">
        Journal & Study
      </span>
    </a>

    <nav aria-label="主导航" class="hidden items-center gap-1 md:flex">
      {
        NAV_LINKS.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class:list={[
                'rounded-full px-3.5 py-1.5 text-sm transition-colors',
                active
                  ? 'bg-[var(--surface-subtle)] font-medium text-[var(--accent)]'
                  : 'text-[var(--text-muted)] hover:bg-[var(--surface-subtle)] hover:text-[var(--text)]',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-open-search
        class="inline-flex h-8 items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)] px-3 text-xs text-[var(--text-muted)] hover:text-[var(--text)] transition-colors cursor-pointer"
      >
        <svg
          class="h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <span class="hidden sm:inline">搜索</span>
        <kbd class="hidden rounded border border-[var(--border)] px-1 text-[10px] font-mono sm:inline">
          ⌘K
        </kbd>
      </button>
      <ThemeToggle />
    </div>
  </div>

  <!-- Mobile compact nav -->
  <nav
    aria-label="移动端导航"
    class="flex items-center gap-1 overflow-x-auto border-t border-[var(--border)] px-4 py-1.5 md:hidden"
  >
    {
      NAV_LINKS.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            class:list={[
              'shrink-0 rounded-full px-3 py-1 text-xs transition-colors',
              active
                ? 'bg-[var(--surface-subtle)] font-medium text-[var(--accent)]'
                : 'text-[var(--text-muted)]',
            ]}
          >
            {link.label}
          </a>
        );
      })
    }
  </nav>
</header>
