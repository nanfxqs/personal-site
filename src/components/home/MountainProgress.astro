---
import type { SubjectId } from '@/data/syllabus';
import type { ProgressStats } from '@/lib/kb-graph';

interface MountainItem {
  id: SubjectId;
  title: string;
  subtitle: string;
  href: string;
  stats: ProgressStats;
  /** Peak height factor for visual variety */
  peakY: number;
}

interface Props {
  items: MountainItem[];
}

const { items } = Astro.props;

/** Compute climber (x, y) along a two-segment mountain ridge: (24,132) -> (140,peakY) -> (256,132) */
function getClimberPos(percent: number, peakY: number) {
  const t = Math.max(0.06, Math.min(1, percent / 100));
  const startX = 24;
  const startY = 132;
  const peakX = 140;
  const x = startX + (peakX - startX) * t;
  const y = startY + (peakY - startY) * t;
  return { x, y };
}
---

<div class="grid grid-cols-1 gap-5 md:grid-cols-3">
  {
    items.map((item) => {
      const pos = getClimberPos(item.stats.percent, item.peakY);
      const ridgeLen = Math.hypot(140 - 24, item.peakY - 132);
      const climbedLen = ridgeLen * Math.max(0.06, Math.min(1, item.stats.percent / 100));
      return (
        <a
          href={item.href}
          class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5 transition-all hover:border-[var(--text)]"
        >
          <div class="flex items-baseline justify-between gap-2">
            <div>
              <h3 class="font-editorial text-lg font-semibold text-[var(--text)]">
                {item.title}
              </h3>
              <p class="mt-0.5 text-xs text-[var(--text-muted)]">{item.subtitle}</p>
            </div>
            <span class="font-mono text-xs text-[var(--text-muted)]">
              {item.stats.published}/{item.stats.total}
            </span>
          </div>

          <!-- Minimalist Line-Art Mountain SVG -->
          <div class="my-4">
            <svg
              viewBox="0 0 280 148"
              class="h-32 w-full overflow-visible"
              aria-hidden="true"
            >
              {/* Subtle contour lines */}
              <path
                d={`M 12 132 L 140 ${item.peakY} L 268 132`}
                fill="none"
                stroke="var(--border)"
                stroke-width="1.2"
                stroke-dasharray="3 3"
              />
              {/* Secondary background ridge */}
              <path
                d={`M 75 132 L 185 ${item.peakY + 26} L 265 132`}
                fill="none"
                stroke="var(--border)"
                stroke-width="1"
                opacity="0.6"
              />
              {/* Base ground line */}
              <line
                x1="12"
                y1="132"
                x2="268"
                y2="132"
                stroke="var(--border)"
                stroke-width="1"
              />
              {/* Climbed progress path along left ridge */}
              <line
                x1="24"
                y1="132"
                x2={pos.x}
                y2={pos.y}
                stroke="var(--text)"
                stroke-width="2"
                stroke-linecap="round"
                style={`stroke-dasharray: ${ridgeLen}; stroke-dashoffset: ${ridgeLen - climbedLen};`}
              />
              {/* Summit flag */}
              <line
                x1="140"
                y1={item.peakY}
                x2="140"
                y2={item.peakY - 14}
                stroke="var(--text-muted)"
                stroke-width="1.2"
              />
              <polygon
                points={`140,${item.peakY - 14} 150,${item.peakY - 10} 140,${item.peakY - 6}`}
                fill="none"
                stroke="var(--text-muted)"
                stroke-width="1"
              />
              {/* Climber figure (minimalist stick/dot silhouette) */}
              <g transform={`translate(${pos.x}, ${pos.y})`} class="transition-transform duration-300 group-hover:scale-110">
                <circle cx="0" cy="-11" r="2.6" fill="var(--text)" />
                <line x1="0" y1="-8.4" x2="0" y2="-2.5" stroke="var(--text)" stroke-width="1.6" stroke-linecap="round" />
                <line x1="0" y1="-6.5" x2="-3" y2="-4" stroke="var(--text)" stroke-width="1.2" stroke-linecap="round" />
                <line x1="0" y1="-6.5" x2="3.2" y2="-8" stroke="var(--text)" stroke-width="1.2" stroke-linecap="round" />
                <line x1="0" y1="-2.5" x2="-2.5" y2="1" stroke="var(--text)" stroke-width="1.3" stroke-linecap="round" />
                <line x1="0" y1="-2.5" x2="2.5" y2="1" stroke="var(--text)" stroke-width="1.3" stroke-linecap="round" />
              </g>
            </svg>
          </div>

          <div class="flex items-center justify-between border-t border-[var(--border)] pt-3 text-xs">
            <span class="font-mono text-[var(--text-muted)]">
              攀登进度 {item.stats.percent}%
            </span>
            <span class="text-[var(--text-muted)] group-hover:text-[var(--text)] transition-colors">
              进入山脊 →
            </span>
          </div>
        </a>
      );
    })
  }
</div>
