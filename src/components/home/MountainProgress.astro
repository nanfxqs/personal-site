---
import { SITE } from '@/config/site';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import type { ProgressStats } from '@/lib/kb-graph';

interface Props {
  overallStats: ProgressStats;
  stats408: ProgressStats;
  statsMath1: ProgressStats;
  statsEnglish1: ProgressStats;
  courseStats408: {
    ds: ProgressStats;
    co: ProgressStats;
    os: ProgressStats;
    cn: ProgressStats;
  };
  journalCount: number;
  latestPostTitle: string | null;
  latestPostSlug: string | null;
  latestPostDate: string | null;
}

const {
  overallStats,
  stats408,
  statsMath1,
  statsEnglish1,
  courseStats408,
  journalCount,
  latestPostTitle,
  latestPostSlug,
  latestPostDate,
} = Astro.props;

/**
 * Compute climber position along the grand ascending main ridge:
 * Foothills (130, 620) -> Mid-saddle (520, 405) -> Summit (920, 152)
 */
const climbT = Math.max(0.08, Math.min(0.98, overallStats.percent / 100));
const climberX = 130 + (920 - 130) * climbT;
const climberY = 620 + (152 - 620) * climbT;

/** Helper to interpolate a point along a route segment */
function lerpPoint(
  x1: number,
  y1: number,
  x2: number,
  y2: number,
  percent: number,
  minT = 0.22,
) {
  const t = Math.max(minT, Math.min(0.95, percent / 100));
  return {
    x: x1 + (x2 - x1) * t,
    y: y1 + (y2 - y1) * t,
  };
}

// 408 Tree-Structured Ridge Fork on the western shoulder
// Keep minT >= 0.42 so low-progress course dots stay well separated from the 408 hub label
const node408TrunkStart = { x: 265, y: 540 };
const node408Hub = { x: 388, y: 452 };
const branchDS = lerpPoint(node408Hub.x, node408Hub.y, 265, 322, courseStats408.ds.percent, 0.48);
const branchCO = lerpPoint(node408Hub.x, node408Hub.y, 388, 286, courseStats408.co.percent, 0.48);
const branchOS = lerpPoint(node408Hub.x, node408Hub.y, 500, 316, courseStats408.os.percent, 0.48);
const branchCN = lerpPoint(node408Hub.x, node408Hub.y, 566, 392, courseStats408.cn.percent, 0.46);

// Math I & English I Ridge Progress Nodes
const nodeMath1 = lerpPoint(575, 365, 1110, 228, statsMath1.percent, 0.22);
const nodeEnglish1 = lerpPoint(735, 468, 1295, 336, statsEnglish1.percent, 0.22);

// Fine engraving/hatching strokes along the shaded right flank of the main peak
const hatchLines = Array.from({ length: 18 }, (_, i) => {
  const t = i / 17;
  const x1 = 920 + t * 230;
  const y1 = 152 + t * 280;
  const len = 18 + Math.sin(t * Math.PI) * 34;
  return { x1, y1, x2: x1 + len * 0.65, y2: y1 + len };
});

const mobileSubjects = [
  {
    title: '408 专业基础',
    href: '/kb/408',
    dot: 'bg-[var(--subject-408)]',
    percent: stats408.percent,
    meta: `已点亮 ${stats408.published}/${stats408.total}`,
    subLinks: [
      { label: '数据结构', count: `${courseStats408.ds.published}/${courseStats408.ds.total}`, href: '/kb/408/ds' },
      { label: '计组', count: `${courseStats408.co.published}/${courseStats408.co.total}`, href: '/kb/408/co' },
      { label: 'OS', count: `${courseStats408.os.published}/${courseStats408.os.total}`, href: '/kb/408/os' },
      { label: '计网', count: `${courseStats408.cn.published}/${courseStats408.cn.total}`, href: '/kb/408/cn' },
    ],
  },
  {
    title: '数学一',
    href: '/kb/math1',
    dot: 'bg-[var(--subject-math1)]',
    percent: statsMath1.percent,
    meta: `高数 · 线代 · 概率论 (${statsMath1.published}/${statsMath1.total})`,
    subLinks: [],
  },
  {
    title: '英语一',
    href: '/kb/english1',
    dot: 'bg-[var(--subject-english1)]',
    percent: statsEnglish1.percent,
    meta: `词句 · 阅读 · 翻译写作 (${statsEnglish1.published}/${statsEnglish1.total})`,
    subLinks: [],
  },
];
---

<section
  id="home-poster"
  class="relative flex w-full flex-col justify-between overflow-x-clip md:min-h-[calc(100dvh-3.75rem)] md:overflow-hidden"
>
  <!-- Top Editorial Anchor -->
  <div class="relative z-30 flex flex-col justify-between gap-4 px-5 pt-7 sm:px-8 sm:pt-9 md:flex-row md:items-start lg:px-12">
    <div class="max-w-[34rem]">
      <div class="flex flex-wrap items-baseline gap-x-3.5 gap-y-1">
        <h1 class="font-editorial text-[2.25rem] leading-[1.1] tracking-tight text-foreground italic sm:text-5xl">
          {SITE.nickname}.
        </h1>
        <span class="text-xs font-medium text-muted-foreground tabular-nums">
          <span class="text-primary">攀登进度 {overallStats.percent}%</span>
          <span class="mx-1.5 opacity-45">/</span>
          <span>已点亮 {overallStats.published} / {overallStats.total}</span>
        </span>
      </div>

      <p class="mt-3 font-editorial text-sm leading-[1.78] text-muted-foreground sm:text-[15px]">
        {SITE.bio}
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-2.5">
        <a
          href="/kb"
          class={cn(buttonVariants({ variant: 'default', size: 'sm' }), 'rounded-full px-4')}
        >
          探索知识库
        </a>
        <a
          href="/graph"
          class={cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'rounded-full px-3.5')}
        >
          <span>跨科知识图谱</span>
          <span aria-hidden="true" class="text-primary">→</span>
        </a>
      </div>
    </div>

    <div class="hidden text-right text-xs text-muted-foreground md:block">
      <div class="inline-flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-600 dark:bg-emerald-400" aria-hidden="true"></span>
        <span>{SITE.status}</span>
      </div>
    </div>
  </div>

  <!-- Topographic Mountain Visual (Full-viewport hero on md+, crisp landscape banner on mobile) -->
  <div class="relative z-10 mt-4 flex items-center justify-center px-2 sm:px-4 md:pointer-events-auto md:absolute md:inset-0 md:mt-0 md:px-0">
    <svg
      viewBox="0 0 1440 720"
      preserveAspectRatio="xMidYMid meet"
      class="aspect-[2/1] w-full max-w-none overflow-visible md:aspect-auto md:h-full md:max-h-[90vh]"
      role="img"
      aria-label="等高线高山进度主视觉：展示考研总体攀登进度、408 分叉山脊与数学一、英语一山脊坐标"
    >
      <defs>
        <linearGradient id="mist-fill-far" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--subject-408)" stop-opacity="0.11" />
          <stop offset="85%" stop-color="var(--background)" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="mist-fill-mid" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--subject-math1)" stop-opacity="0.09" />
          <stop offset="100%" stop-color="var(--background)" stop-opacity="0" />
        </linearGradient>
        <radialGradient id="lunar-halo" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="var(--primary)" stop-opacity="0.18" />
          <stop offset="55%" stop-color="var(--subject-math1)" stop-opacity="0.06" />
          <stop offset="100%" stop-color="var(--background)" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="ridge-sheen" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="var(--subject-408)" stop-opacity="0.58" />
          <stop offset="45%" stop-color="var(--primary)" stop-opacity="0.95" />
          <stop offset="55%" stop-color="#bae6fd" stop-opacity="1" />
          <stop offset="100%" stop-color="var(--subject-math1)" stop-opacity="0.62" />
          <animateTransform
            attributeName="gradientTransform"
            type="translate"
            from="-1 0"
            to="1 0"
            dur="7s"
            repeatCount="indefinite"
          />
        </linearGradient>
        <linearGradient id="climbed-trail-grad" x1="0%" y1="100%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="var(--subject-408)" />
          <stop offset="100%" stop-color="var(--subject-math1)" />
        </linearGradient>
      </defs>

      <!-- Layer 0: Subtle Cartographic Grid & Atmospheric Halo -->
      <g data-parallax="0.18" opacity="0.72">
        <circle cx="920" cy="210" r="170" fill="url(#lunar-halo)" />
        <circle
          cx="920"
          cy="210"
          r="92"
          fill="none"
          stroke="var(--border)"
          stroke-width="0.7"
          stroke-dasharray="2 6"
          opacity="0.65"
        />
        <line x1="36" y1="620" x2="1404" y2="620" stroke="var(--border)" stroke-width="0.9" />
        <line x1="920" y1="90" x2="920" y2="635" stroke="var(--border)" stroke-width="0.6" stroke-dasharray="2 7" opacity="0.55" />
      </g>

      <!-- Layer 1: Distant Mist Mountain Silhouettes -->
      <g data-parallax="0.38">
        <path
          d="M 20 620 C 170 555, 290 420, 445 365 C 580 318, 695 430, 825 320 C 960 205, 1070 155, 1185 255 C 1275 335, 1345 480, 1420 620 Z"
          fill="url(#mist-fill-far)"
          stroke="var(--border)"
          stroke-width="0.9"
          opacity="0.78"
        />
        <path
          d="M 480 620 C 610 515, 725 385, 865 340 C 1010 294, 1150 385, 1345 620 Z"
          fill="url(#mist-fill-mid)"
          stroke="var(--border)"
          stroke-width="0.8"
          stroke-dasharray="4 5"
          opacity="0.62"
        />
      </g>

      <!-- Layer 2: Organic Topographic Contours & Shaded Slope Hatching -->
      <g data-parallax="0.68">
        <path
          d="M 60 585 Q 340 535, 620 570 T 1360 550"
          fill="none"
          stroke="var(--border)"
          stroke-width="0.75"
          stroke-dasharray="3 6"
          opacity="0.72"
        />
        <path
          d="M 150 510 Q 470 430, 770 485 T 1300 470"
          fill="none"
          stroke="var(--border)"
          stroke-width="0.75"
          stroke-dasharray="2 5"
          opacity="0.6"
        />
        <path
          d="M 280 425 Q 610 315, 920 385 T 1220 390"
          fill="none"
          stroke="var(--border)"
          stroke-width="0.75"
          stroke-dasharray="2 6"
          opacity="0.5"
        />

        <g stroke="var(--text-muted)" stroke-width="0.7" opacity="0.28">
          {hatchLines.map((h) => (
            <line x1={h.x1} y1={h.y1} x2={h.x2} y2={h.y2} />
          ))}
        </g>
      </g>

      <!-- Layer 3: Main Grand Mountain Ridge & Ascent Spine -->
      <g data-parallax="1.0">
        <path
          d="M 40 620 C 165 565, 290 480, 415 415 C 540 350, 625 340, 735 268 C 815 215, 870 175, 920 152 C 985 188, 1085 288, 1185 415 C 1270 520, 1345 580, 1410 620"
          pathLength="1"
          fill="none"
          stroke="url(#ridge-sheen)"
          stroke-width="1.85"
          stroke-linecap="round"
          class="animate-draw-ridge"
        />

        <line
          x1="130"
          y1="620"
          x2="920"
          y2="152"
          stroke="var(--border)"
          stroke-width="1.25"
          stroke-dasharray="4 5"
        />

        <line
          x1="130"
          y1="620"
          x2={climberX}
          y2={climberY}
          stroke="url(#climbed-trail-grad)"
          stroke-width="2.8"
          stroke-linecap="round"
        />

        <!-- Summit Flag -->
        <g transform="translate(920, 152)">
          <line x1="0" y1="0" x2="0" y2="-30" stroke="var(--text)" stroke-width="1.3" />
          <polygon points="0,-30 19,-23 0,-16" fill="none" stroke="var(--text)" stroke-width="1.2" />
          <text
            x="26"
            y="-19"
            class="fill-[var(--text-muted)] font-mono text-[10px] tracking-[0.16em]"
          >
            SUMMIT · 100%
          </text>
        </g>

        <!-- 408 Tree-Structured Ridge Fork (4 Courses: DS, CO, OS, CN) -->
        <g>
          <line
            x1={node408TrunkStart.x}
            y1={node408TrunkStart.y}
            x2={node408Hub.x}
            y2={node408Hub.y}
            stroke="var(--text-muted)"
            stroke-width="1.5"
          />
          <path d={`M ${node408Hub.x} ${node408Hub.y} Q 316 392, 265 322`} fill="none" stroke="var(--border)" stroke-width="1.2" />
          <path d={`M ${node408Hub.x} ${node408Hub.y} Q 384 368, 388 286`} fill="none" stroke="var(--border)" stroke-width="1.2" />
          <path d={`M ${node408Hub.x} ${node408Hub.y} Q 454 376, 500 316`} fill="none" stroke="var(--border)" stroke-width="1.2" />
          <path d={`M ${node408Hub.x} ${node408Hub.y} Q 484 410, 566 392`} fill="none" stroke="var(--border)" stroke-width="1.2" />

          <line x1={node408Hub.x} y1={node408Hub.y} x2={branchDS.x} y2={branchDS.y} stroke="var(--subject-408)" stroke-width="1.75" opacity="0.85" />
          <line x1={node408Hub.x} y1={node408Hub.y} x2={branchCO.x} y2={branchCO.y} stroke="var(--subject-408)" stroke-width="1.75" opacity="0.85" />
          <line x1={node408Hub.x} y1={node408Hub.y} x2={branchOS.x} y2={branchOS.y} stroke="var(--subject-408)" stroke-width="1.75" opacity="0.85" />
          <line x1={node408Hub.x} y1={node408Hub.y} x2={branchCN.x} y2={branchCN.y} stroke="var(--subject-408)" stroke-width="1.75" opacity="0.85" />

          <!-- 408 Hub Anchor (label positioned cleanly below-right so it never collides with branch dots) -->
          <a href="/kb/408" class="ridge-node-link group cursor-pointer">
            <circle
              cx={node408Hub.x}
              cy={node408Hub.y}
              r="15"
              fill="var(--subject-408)"
              opacity="0.14"
              class="transition-opacity group-hover:opacity-28"
            />
            <circle
              cx={node408Hub.x}
              cy={node408Hub.y}
              r="6.5"
              fill="var(--background)"
              stroke="var(--subject-408)"
              stroke-width="2.2"
            />
            <text
              x={node408Hub.x + 14}
              y={node408Hub.y + 22}
              class="fill-foreground font-editorial text-[16px] group-hover:underline"
            >
              408 · {stats408.percent}%
            </text>
          </a>

          <!-- 4 Sub-branch Coordinate Nodes -->
          <a href="/kb/408/ds" class="ridge-node-link group cursor-pointer">
            <circle cx={branchDS.x} cy={branchDS.y} r="4" fill="var(--subject-408)" />
            <text x="256" y="314" text-anchor="end" class="fill-[var(--text-muted)] font-sans text-[12px] transition-colors group-hover:fill-[var(--text)]">
              数据结构 <tspan class="font-mono text-[10px]">{courseStats408.ds.published}/{courseStats408.ds.total}</tspan>
            </text>
          </a>
          <a href="/kb/408/co" class="ridge-node-link group cursor-pointer">
            <circle cx={branchCO.x} cy={branchCO.y} r="4" fill="var(--subject-408)" />
            <text x="388" y="272" text-anchor="middle" class="fill-[var(--text-muted)] font-sans text-[12px] transition-colors group-hover:fill-[var(--text)]">
              计组 <tspan class="font-mono text-[10px]">{courseStats408.co.published}/{courseStats408.co.total}</tspan>
            </text>
          </a>
          <a href="/kb/408/os" class="ridge-node-link group cursor-pointer">
            <circle cx={branchOS.x} cy={branchOS.y} r="4" fill="var(--subject-408)" />
            <text x="510" y="310" text-anchor="start" class="fill-[var(--text-muted)] font-sans text-[12px] transition-colors group-hover:fill-[var(--text)]">
              OS <tspan class="font-mono text-[10px]">{courseStats408.os.published}/{courseStats408.os.total}</tspan>
            </text>
          </a>
          <a href="/kb/408/cn" class="ridge-node-link group cursor-pointer">
            <circle cx={branchCN.x} cy={branchCN.y} r="4" fill="var(--subject-408)" />
            <text x="576" y="396" text-anchor="start" class="fill-[var(--text-muted)] font-sans text-[12px] transition-colors group-hover:fill-[var(--text)]">
              计网 <tspan class="font-mono text-[10px]">{courseStats408.cn.published}/{courseStats408.cn.total}</tspan>
            </text>
          </a>
        </g>

        <!-- Math I Ridge Line & Coordinate Node -->
        <g>
          <line x1="575" y1="365" x2="1110" y2="228" stroke="var(--border)" stroke-width="1.25" />
          <line x1="575" y1="365" x2={nodeMath1.x} y2={nodeMath1.y} stroke="var(--subject-math1)" stroke-width="2.1" />
          <a href="/kb/math1" class="ridge-node-link group cursor-pointer">
            <circle
              cx={nodeMath1.x}
              cy={nodeMath1.y}
              r="15"
              fill="var(--subject-math1)"
              opacity="0.14"
              class="transition-opacity group-hover:opacity-28"
            />
            <circle
              cx={nodeMath1.x}
              cy={nodeMath1.y}
              r="6.5"
              fill="var(--background)"
              stroke="var(--subject-math1)"
              stroke-width="2.2"
            />
            <text
              x={nodeMath1.x + 14}
              y={nodeMath1.y - 6}
              class="fill-foreground font-editorial text-[16px] group-hover:underline"
            >
              数学一 · {statsMath1.percent}%
            </text>
            <text
              x={nodeMath1.x + 14}
              y={nodeMath1.y + 11}
              class="fill-muted-foreground font-mono text-[11px]"
            >
              高数 · 线代 · 概率论 ({statsMath1.published}/{statsMath1.total})
            </text>
          </a>
        </g>

        <!-- English I Ridge Line & Coordinate Node -->
        <g>
          <line x1="735" y1="468" x2="1295" y2="336" stroke="var(--border)" stroke-width="1.25" />
          <line x1="735" y1="468" x2={nodeEnglish1.x} y2={nodeEnglish1.y} stroke="var(--subject-english1)" stroke-width="2.1" />
          <a href="/kb/english1" class="ridge-node-link group cursor-pointer">
            <circle
              cx={nodeEnglish1.x}
              cy={nodeEnglish1.y}
              r="15"
              fill="var(--subject-english1)"
              opacity="0.14"
              class="transition-opacity group-hover:opacity-28"
            />
            <circle
              cx={nodeEnglish1.x}
              cy={nodeEnglish1.y}
              r="6.5"
              fill="var(--background)"
              stroke="var(--subject-english1)"
              stroke-width="2.2"
            />
            <text
              x={nodeEnglish1.x + 14}
              y={nodeEnglish1.y - 6}
              class="fill-foreground font-editorial text-[16px] group-hover:underline"
            >
              英语一 · {statsEnglish1.percent}%
            </text>
            <text
              x={nodeEnglish1.x + 14}
              y={nodeEnglish1.y + 11}
              class="fill-muted-foreground font-mono text-[11px]"
            >
              词句 · 阅读 · 翻译写作 ({statsEnglish1.published}/{statsEnglish1.total})
            </text>
          </a>
        </g>

        <!-- Lone Climber Ascending the Main Ridge -->
        <g transform={`translate(${climberX}, ${climberY})`}>
          <circle cx="0" cy="-12" r="20" fill="var(--primary)" class="animate-climber-beacon" />
          <circle cx="0" cy="-18" r="3.4" fill="var(--text)" />
          <line x1="0" y1="-14.5" x2="-1.2" y2="-4.5" stroke="var(--text)" stroke-width="2" stroke-linecap="round" />
          <line x1="-0.5" y1="-11.5" x2="5" y2="-9" stroke="var(--text)" stroke-width="1.5" stroke-linecap="round" />
          <line x1="5" y1="-9" x2="6.8" y2="1.5" stroke="var(--text-muted)" stroke-width="1.1" stroke-linecap="round" />
          <line x1="-1.2" y1="-4.5" x2="-5" y2="2" stroke="var(--text)" stroke-width="1.6" stroke-linecap="round" />
          <line x1="-1.2" y1="-4.5" x2="3.2" y2="2" stroke="var(--text)" stroke-width="1.6" stroke-linecap="round" />
          <text
            x="-14"
            y="-28"
            text-anchor="end"
            class="fill-[var(--text)] font-mono text-[11px] font-medium tracking-wider"
          >
            nanf · {overallStats.percent}%
          </text>
        </g>
      </g>
    </svg>
  </div>

  <!-- Mobile-only Readable Subject & Progress List (same real data as SVG ridges) -->
  <div class="relative z-30 mt-3 px-5 md:hidden">
    <div class="divide-y divide-border/75 border-y border-border/75">
      {mobileSubjects.map((sub) => (
        <div class="py-3.5">
          <a
            href={sub.href}
            class="flex items-baseline justify-between gap-3 rounded-sm"
          >
            <span class="flex items-center gap-2 font-editorial text-base text-foreground">
              <span class={`inline-block size-2 shrink-0 rounded-full ${sub.dot}`} aria-hidden="true" />
              <span>{sub.title}</span>
            </span>
            <span class="text-xs font-medium text-foreground tabular-nums">
              {sub.percent}%
            </span>
          </a>
          <p class="mt-1 pl-4 text-xs text-muted-foreground tabular-nums">{sub.meta}</p>
          {sub.subLinks.length > 0 && (
            <div class="mt-2.5 flex flex-wrap gap-x-4 gap-y-1.5 pl-4 text-xs">
              {sub.subLinks.map((c) => (
                <a
                  href={c.href}
                  class="inline-flex items-baseline gap-1 text-muted-foreground transition-colors hover:text-primary"
                >
                  <span class="text-foreground">{c.label}</span>
                  <span class="font-mono text-[11px] tabular-nums">{c.count}</span>
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- Bottom Editorial Anchor: Quiet Note & Latest Journal Dispatch -->
  <div class="relative z-30 mt-6 flex flex-col-reverse justify-between gap-4 px-5 pb-8 sm:px-8 sm:pb-8 md:mt-0 md:flex-row md:items-end lg:px-12">
    <p class="text-xs text-muted-foreground">
      {SITE.nickname} · 日常随笔与考研知识图谱
    </p>

    <div class="w-full rounded-xl border border-border/80 bg-card/88 p-4 backdrop-blur-md md:w-[22rem]">
      <div class="flex items-center justify-between gap-3 text-xs text-muted-foreground">
        <span class="font-medium text-primary">最新日常</span>
        {latestPostDate && <span class="tabular-nums">{latestPostDate}</span>}
      </div>

      {latestPostSlug && latestPostTitle ? (
        <a
          href={`/journal/${latestPostSlug}`}
          class="mt-1.5 block rounded-sm font-editorial text-[15px] leading-snug text-foreground transition-colors hover:text-primary hover:underline underline-offset-4"
        >
          {latestPostTitle}
        </a>
      ) : (
        <p class="mt-1.5 font-editorial text-[15px] text-foreground">
          日常随笔、图像与影音时间线
        </p>
      )}

      <div class="mt-3 flex items-center justify-between border-t border-border/60 pt-2.5 text-xs text-muted-foreground">
        <span class="tabular-nums">日常共 {journalCount} 篇</span>
        <a
          href="/journal"
          class="group inline-flex items-center gap-1 rounded-sm font-medium text-primary transition-colors hover:text-primary/80"
        >
          <span>浏览全部日常</span>
          <span aria-hidden="true" class="transition-transform duration-150 ease-[var(--ease-out)] group-hover:translate-x-0.5">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .ridge-node-link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
  }
</style>

<script is:inline>
  (() => {
    const poster = document.getElementById('home-poster');
    if (!poster) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const layers = Array.from(poster.querySelectorAll('[data-parallax]'));
    if (!layers.length) return;

    let rafId = 0;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;

    const animate = () => {
      currentX += (targetX - currentX) * 0.08;
      currentY += (targetY - currentY) * 0.08;

      for (const layer of layers) {
        const depth = parseFloat(layer.getAttribute('data-parallax') || '0');
        const tx = (currentX * depth * 12).toFixed(2);
        const ty = (currentY * depth * 7).toFixed(2);
        layer.setAttribute('transform', `translate(${tx}, ${ty})`);
      }

      if (Math.abs(targetX - currentX) > 0.002 || Math.abs(targetY - currentY) > 0.002) {
        rafId = requestAnimationFrame(animate);
      } else {
        rafId = 0;
      }
    };

    poster.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const rect = poster.getBoundingClientRect();
      targetX = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
      targetY = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
      if (!rafId) rafId = requestAnimationFrame(animate);
    });

    poster.addEventListener('pointerleave', () => {
      targetX = 0;
      targetY = 0;
      if (!rafId) rafId = requestAnimationFrame(animate);
    });
  })();
</script>
