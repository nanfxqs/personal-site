          <!-- 4 Sub-ridge paths -->
          <path d={`M ${node408Hub.x} ${node408Hub.y} Q 320 395, 275 325`} fill="none" stroke="var(--border)" stroke-width="1.2" />
          <path d={`M ${node408Hub.x} ${node408Hub.y} Q 382 372, 388 290`} fill="none" stroke="var(--border)" stroke-width="1.2" />
          <path d={`M ${node408Hub.x} ${node408Hub.y} Q 452 380, 495 320`} fill="none" stroke="var(--border)" stroke-width="1.2" />
          <path d={`M ${node408Hub.x} ${node408Hub.y} Q 480 412, 558 392`} fill="none" stroke="var(--border)" stroke-width="1.2" />

          <!-- Active progress strokes -->
          <line x1={node408Hub.x} y1={node408Hub.y} x2={branchDS.x} y2={branchDS.y} stroke="var(--text)" stroke-width="1.75" />
          <line x1={node408Hub.x} y1={node408Hub.y} x2={branchCO.x} y2={branchCO.y} stroke="var(--text)" stroke-width="1.75" />
          <line x1={node408Hub.x} y1={node408Hub.y} x2={branchOS.x} y2={branchOS.y} stroke="var(--text)" stroke-width="1.75" />
          <line x1={node408Hub.x} y1={node408Hub.y} x2={branchCN.x} y2={branchCN.y} stroke="var(--text)" stroke-width="1.75" />

          <!-- 408 Hub Anchor -->
          <a href="/kb/408" class="group cursor-pointer">
            <circle
              cx={node408Hub.x}
              cy={node408Hub.y}
              r="14"
              fill="var(--text)"
              opacity="0"
