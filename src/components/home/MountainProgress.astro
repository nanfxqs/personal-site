        </g>

        <!-- 408 Tree-Structured Ridge Fork (4 Courses: DS, CO, OS, CN) -->
        <g>
          <line
            x1={node408TrunkStart.x}
            y1={node408TrunkStart.y}
            x2={node408Hub.x}
            y2={node408Hub.y}
            stroke="var(--text-muted)"
            stroke-width="1.5"
