---
import { SITE } from '@/config/site';
import type { ProgressStats } from '@/lib/kb-graph';

interface Props {
  overallStats: ProgressStats;
  stats408: ProgressStats;
  statsMath1: ProgressStats;
  statsEnglish1: ProgressStats;
  courseStats408: {
    ds: ProgressStats;
    co: ProgressStats;
    os: ProgressStats;
    cn: ProgressStats;
  };
  journalCount: number;
  latestPostTitle: string | null;
  latestPostSlug: string | null;
  latestPostDate: string | null;
}

const {
  overallStats,
  stats408,
  statsMath1,
  statsEnglish1,
  courseStats408,
  journalCount,
  latestPostTitle,
  latestPostSlug,
  latestPostDate,
} = Astro.props;

/**
 * Compute climber position along the grand ascending main ridge:
 * Foothills (130, 620) -> Mid-saddle (520, 405) -> Summit (920, 152)
 */
const climbT = Math.max(0.08, Math.min(0.98, overallStats.percent / 100));
const climberX = 130 + (920 - 130) * climbT;
const climberY = 620 + (152 - 620) * climbT;

/** Helper to interpolate a point along a route segment */
function lerpPoint(x1: number, y1: number, x2: number, y2: number, percent: number) {
  const t = Math.max(0.18, Math.min(0.95, percent / 100));
  return {
    x: x1 + (x2 - x1) * t,
    y: y1 + (y2 - y1) * t,
  };
}

// 408 Tree-Structured Ridge Fork on the western shoulder
const node408TrunkStart = { x: 265, y: 540 };
const node408Hub = { x: 388, y: 452 };
const branchDS = lerpPoint(node408Hub.x, node408Hub.y, 275, 325, courseStats408.ds.percent);
const branchCO = lerpPoint(node408Hub.x, node408Hub.y, 388, 290, courseStats408.co.percent);
const branchOS = lerpPoint(node408Hub.x, node408Hub.y, 495, 320, courseStats408.os.percent);
const branchCN = lerpPoint(node408Hub.x, node408Hub.y, 558, 392, courseStats408.cn.percent);

// Math I & English I Ridge Progress Nodes
const nodeMath1 = lerpPoint(575, 365, 1110, 228, statsMath1.percent);
const nodeEnglish1 = lerpPoint(735, 468, 1295, 336, statsEnglish1.percent);

// Fine engraving/hatching strokes along the shaded right flank of the main peak
const hatchLines = Array.from({ length: 18 }, (_, i) => {
  const t = i / 17;
  const x1 = 920 + t * 230;
  const y1 = 152 + t * 280;
  const len = 18 + Math.sin(t * Math.PI) * 34;
  return { x1, y1, x2: x1 + len * 0.65, y2: y1 + len };
});
---

<section
  id="home-poster"
  class="relative flex min-h-[calc(100dvh-3.75rem)] w-full flex-col justify-between overflow-hidden bg-[var(--bg)] select-none"
>
  <!-- Atmospheric Paper Grain & Soft Vignette -->
  <div aria-hidden="true" class="poster-grain pointer-events-none absolute inset-0 z-20"></div>
  <div aria-hidden="true" class="poster-vignette pointer-events-none absolute inset-0 z-10"></div>

  <!-- Top Poster Corner Anchors (Floating over negative space on md+) -->
  <div class="relative z-30 flex flex-col justify-between gap-6 px-5 pt-7 sm:px-8 sm:pt-9 md:flex-row md:items-start lg:px-12">
    <!-- Top-Left: Minimalist Signature & Overall Elevation -->
    <div class="max-w-md space-y-2.5">
      <div class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--bg)]/70 px-2.5 py-0.5 text-[11px] font-mono text-[var(--text-muted)] backdrop-blur-sm">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        <span>{SITE.status}</span>
      </div>

      <div class="flex items-baseline gap-3">
        <h1 class="font-editorial text-4xl font-semibold tracking-tight text-[var(--text)] italic sm:text-5xl">
          {SITE.nickname}.
        </h1>
        <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--text-muted)]">
          ELEV. {overallStats.percent}%
        </span>
      </div>

      <p class="font-editorial text-sm leading-relaxed text-[var(--text-muted)] sm:text-[15px]">
        {SITE.bio}
      </p>
    </div>

    <!-- Top-Right: Cartographic Metadata & Graph Entry -->
    <div class="flex items-center justify-between gap-6 md:flex-col md:items-end md:gap-2">
      <div class="font-mono text-[10px] uppercase tracking-[0.24em] text-[var(--text-muted)]">
        01 / ASCENT · {overallStats.published} OF {overallStats.total} TOPICS
      </div>
      <a
        href="/graph"
        class="group inline-flex items-center gap-2 text-xs font-medium text-[var(--text-muted)] transition-colors hover:text-[var(--text)]"
      >
        <span class="underline decoration-[var(--border)] underline-offset-4 group-hover:decoration-[var(--text)]">
          跨科知识图谱
        </span>
        <span class="transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    </div>
  </div>

  <!-- Full-Viewport Lithograph / Topographic Mountain Visual -->
  <div class="relative z-10 flex flex-1 items-center justify-center px-1 sm:px-4 md:absolute md:inset-0 md:px-0">
    <svg
      viewBox="0 0 1440 760"
      preserveAspectRatio="xMidYMid meet"
      class="h-full max-h-[62vh] w-full overflow-visible md:max-h-[92vh]"
      role="img"
      aria-label="极简等高线高山主视觉：展示考研总体攀登进度、408 分叉山脊与数学一、英语一山脊坐标"
    >
      <defs>
        <!-- Soft atmospheric mist gradient for distant peaks -->
        <linearGradient id="mist-fill-far" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--text)" stop-opacity="0.05" />
          <stop offset="85%" stop-color="var(--bg)" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="mist-fill-mid" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--text)" stop-opacity="0.035" />
          <stop offset="100%" stop-color="var(--bg)" stop-opacity="0" />
        </linearGradient>
        <radialGradient id="lunar-halo" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="var(--text)" stop-opacity="0.07" />
          <stop offset="65%" stop-color="var(--text)" stop-opacity="0.02" />
          <stop offset="100%" stop-color="var(--bg)" stop-opacity="0" />
        </radialGradient>
      </defs>

      <!-- Layer 0: Subtle Cartographic Grid & Atmospheric Halo -->
      <g data-parallax="0.18" opacity="0.7">
        <circle cx="920" cy="210" r="175" fill="url(#lunar-halo)" />
        <circle
          cx="920"
          cy="210"
          r="92"
          fill="none"
          stroke="var(--border)"
          stroke-width="0.7"
          stroke-dasharray="2 6"
          opacity="0.65"
        />
        <!-- Fine horizon & cartographic coordinate ticks -->
        <line x1="36" y1="620" x2="1404" y2="620" stroke="var(--border)" stroke-width="0.9" />
        <line x1="920" y1="90" x2="920" y2="640" stroke="var(--border)" stroke-width="0.6" stroke-dasharray="2 7" opacity="0.55" />
        <text x="48" y="640" class="fill-[var(--text-muted)] font-mono text-[10px] tracking-[0.2em]" opacity="0.65">
          BASE · 0M
        </text>
        <text x="1392" y="640" text-anchor="end" class="fill-[var(--text-muted)] font-mono text-[10px] tracking-[0.2em]" opacity="0.65">
          408 · MATH I · ENGLISH I
        </text>
      </g>

      <!-- Layer 1: Distant Mist Mountain Silhouettes -->
      <g data-parallax="0.38">
        <path
          d="M 20 620 C 170 555, 290 420, 445 365 C 580 318, 695 430, 825 320 C 960 205, 1070 155, 1185 255 C 1275 335, 1345 480, 1420 620 Z"
          fill="url(#mist-fill-far)"
          stroke="var(--border)"
          stroke-width="0.9"
          opacity="0.75"
        />
        <path
          d="M 480 620 C 610 515, 725 385, 865 340 C 1010 294, 1150 385, 1345 620 Z"
          fill="url(#mist-fill-mid)"
          stroke="var(--border)"
          stroke-width="0.8"
          stroke-dasharray="4 5"
          opacity="0.6"
        />
      </g>

      <!-- Layer 2: Organic Topographic Contours & Shaded Slope Hatching -->
      <g data-parallax="0.68">
        <!-- Concentric elevation contours sweeping across the valley -->
        <path
          d="M 60 585 Q 340 535, 620 570 T 1360 550"
          fill="none"
          stroke="var(--border)"
          stroke-width="0.75"
          stroke-dasharray="3 6"
          opacity="0.7"
        />
        <path
          d="M 150 510 Q 470 430, 770 485 T 1300 470"
          fill="none"
          stroke="var(--border)"
          stroke-width="0.75"
          stroke-dasharray="2 5"
          opacity="0.58"
        />
        <path
          d="M 280 425 Q 610 315, 920 385 T 1220 390"
          fill="none"
          stroke="var(--border)"
          stroke-width="0.75"
          stroke-dasharray="2 6"
          opacity="0.48"
        />

        <!-- Lithograph / engraving hatching on shaded eastern flank -->
        <g stroke="var(--text-muted)" stroke-width="0.7" opacity="0.28">
          {hatchLines.map((h) => (
            <line x1={h.x1} y1={h.y1} x2={h.x2} y2={h.y2} />
          ))}
        </g>
      </g>

      <!-- Layer 3: Main Grand Mountain Ridge & Ascent Spine -->
      <g data-parallax="1.0">
        <!-- Grand Organic Mountain Silhouette (Pen-drawn on load) -->
        <path
          d="M 40 620 C 165 565, 290 480, 415 415 C 540 350, 625 340, 735 268 C 815 215, 870 175, 920 152 C 985 188, 1085 288, 1185 415 C 1270 520, 1345 580, 1410 620"
          fill="none"
          stroke="var(--text-muted)"
          stroke-width="1.35"
          stroke-linecap="round"
          class="animate-draw-ridge"
          style="--ridge-length: 1850;"
        />

        <!-- Main Ascent Spine (Foot -> Summit) -->
        <line
          x1="130"
          y1="620"
          x2="920"
          y2="152"
          stroke="var(--border)"
          stroke-width="1.25"
          stroke-dasharray="4 5"
        />

        <!-- Climbed Solid Ink Trail behind the lone climber -->
        <line
          x1="130"
          y1="620"
          x2={climberX}
          y2={climberY}
          stroke="var(--text)"
          stroke-width="2.4"
          stroke-linecap="round"
        />

        <!-- Summit Flag & Elevation Readout -->
        <g transform="translate(920, 152)">
          <line x1="0" y1="0" x2="0" y2="-30" stroke="var(--text)" stroke-width="1.3" />
          <polygon points="0,-30 19,-23 0,-16" fill="none" stroke="var(--text)" stroke-width="1.2" />
          <text
