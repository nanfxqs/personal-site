            >
              408 · {stats408.percent}%
            </text>
          </a>

          <!-- 4 Sub-branch Coordinate Nodes (Minimal by default, detailed on hover) -->
          <a href="/kb/408#course-ds" class="group cursor-pointer">
            <circle cx={branchDS.x} cy={branchDS.y} r="4.5" fill="var(--text)" class="transition-transform group-hover:scale-125" />
            <text x="268" y="314" text-anchor="end" class="fill-[var(--text-muted)] font-sans text-[12px] transition-colors group-hover:fill-[var(--text)]">
              数据结构 <tspan class="font-mono text-[10px] opacity-70">{courseStats408.ds.published}/{courseStats408.ds.total}</tspan>
            </text>
          </a>
          <a href="/kb/408#course-co" class="group cursor-pointer">
            <circle cx={branchCO.x} cy={branchCO.y} r="4.5" fill="var(--text)" class="transition-transform group-hover:scale-125" />
            <text x="388" y="276" text-anchor="middle" class="fill-[var(--text-muted)] font-sans text-[12px] transition-colors group-hover:fill-[var(--text)]">
              计组 <tspan class="font-mono text-[10px] opacity-70">{courseStats408.co.published}/{courseStats408.co.total}</tspan>
            </text>
          </a>
          <a href="/kb/408#course-os" class="group cursor-pointer">
            <circle cx={branchOS.x} cy={branchOS.y} r="4.5" fill="var(--text)" class="transition-transform group-hover:scale-125" />
            <text x="504" y="314" text-anchor="start" class="fill-[var(--text-muted)] font-sans text-[12px] transition-colors group-hover:fill-[var(--text)]">
              OS <tspan class="font-mono text-[10px] opacity-70">{courseStats408.os.published}/{courseStats408.os.total}</tspan>
            </text>
          </a>
          <a href="/kb/408#course-cn" class="group cursor-pointer">
            <circle cx={branchCN.x} cy={branchCN.y} r="4.5" fill="var(--text)" class="transition-transform group-hover:scale-125" />
            <text x="568" y="395" text-anchor="start" class="fill-[var(--text-muted)] font-sans text-[12px] transition-colors group-hover:fill-[var(--text)]">
              计网 <tspan class="font-mono text-[10px] opacity-70">{courseStats408.cn.published}/{courseStats408.cn.total}</tspan>
            </text>
          </a>
        </g>

        <!-- Math I Ridge Line & Coordinate Node -->
        <g>
          <line x1="575" y1="365" x2="1110" y2="228" stroke="var(--border)" stroke-width="1.25" />
          <line x1="575" y1="365" x2={nodeMath1.x} y2={nodeMath1.y} stroke="var(--text)" stroke-width="1.9" />
          <a href="/kb/math1" class="group cursor-pointer">
            <circle
              cx={nodeMath1.x}
              cy={nodeMath1.y}
              r="14"
              fill="var(--text)"
              opacity="0"
              class="transition-opacity group-hover:opacity-10"
            />
            <circle
              cx={nodeMath1.x}
              cy={nodeMath1.y}
              r="6.5"
              fill="var(--bg)"
              stroke="var(--text)"
              stroke-width="2"
              class="transition-transform group-hover:scale-125"
            />
            <text
              x={nodeMath1.x + 14}
              y={nodeMath1.y - 6}
              class="fill-[var(--text)] font-editorial text-[16px] font-semibold group-hover:underline"
            >
              数学一 · {statsMath1.percent}%
            </text>
            <text
              x={nodeMath1.x + 14}
              y={nodeMath1.y + 11}
              class="fill-[var(--text-muted)] font-mono text-[11px]"
            >
              高数 · 线代 · 概率论 ({statsMath1.published}/{statsMath1.total})
            </text>
          </a>
        </g>

        <!-- English I Ridge Line & Coordinate Node -->
        <g>
          <line x1="735" y1="468" x2="1295" y2="336" stroke="var(--border)" stroke-width="1.25" />
          <line x1="735" y1="468" x2={nodeEnglish1.x} y2={nodeEnglish1.y} stroke="var(--text)" stroke-width="1.9" />
          <a href="/kb/english1" class="group cursor-pointer">
            <circle
              cx={nodeEnglish1.x}
              cy={nodeEnglish1.y}
              r="14"
              fill="var(--text)"
              opacity="0"
              class="transition-opacity group-hover:opacity-10"
            />
            <circle
              cx={nodeEnglish1.x}
              cy={nodeEnglish1.y}
              r="6.5"
              fill="var(--bg)"
              stroke="var(--text)"
              stroke-width="2"
              class="transition-transform group-hover:scale-125"
            />
            <text
              x={nodeEnglish1.x + 14}
              y={nodeEnglish1.y - 6}
              class="fill-[var(--text)] font-editorial text-[16px] font-semibold group-hover:underline"
            >
              英语一 · {statsEnglish1.percent}%
            </text>
            <text
              x={nodeEnglish1.x + 14}
              y={nodeEnglish1.y + 11}
              class="fill-[var(--text-muted)] font-mono text-[11px]"
            >
              词句 · 阅读 · 翻译写作 ({statsEnglish1.published}/{statsEnglish1.total})
            </text>
          </a>
        </g>

        <!-- Lone Climber Ascending the Main Ridge -->
        <g transform={`translate(${climberX}, ${climberY})`}>
          <circle cx="0" cy="-12" r="18" fill="var(--text)" class="animate-climber-beacon" />
          <circle cx="0" cy="-18" r="3.4" fill="var(--text)" />
          <line x1="0" y1="-14.5" x2="-1.2" y2="-4.5" stroke="var(--text)" stroke-width="2" stroke-linecap="round" />
          <line x1="-0.5" y1="-11.5" x2="5" y2="-9" stroke="var(--text)" stroke-width="1.5" stroke-linecap="round" />
          <line x1="5" y1="-9" x2="6.8" y2="1.5" stroke="var(--text-muted)" stroke-width="1.1" stroke-linecap="round" />
          <line x1="-1.2" y1="-4.5" x2="-5" y2="2" stroke="var(--text)" stroke-width="1.6" stroke-linecap="round" />
          <line x1="-1.2" y1="-4.5" x2="3.2" y2="2" stroke="var(--text)" stroke-width="1.6" stroke-linecap="round" />
          <text
            x="-14"
            y="-28"
            text-anchor="end"
            class="fill-[var(--text)] font-mono text-[11px] font-medium tracking-wider"
          >
            nanf · {overallStats.percent}%
          </text>
        </g>
      </g>
    </svg>
  </div>

  <!-- Bottom Poster Corner Anchors (Colophon & Latest Dispatch Exhibition Plaque) -->
  <div class="relative z-30 flex flex-col-reverse justify-between gap-4 px-5 pb-6 sm:px-8 sm:pb-8 md:flex-row md:items-end lg:px-12">
    <!-- Bottom-Left: Quiet Exhibition Colophon -->
    <div class="font-mono text-[11px] tracking-wider text-[var(--text-muted)]">
      <span>{SITE.nickname} · 日常随笔与考研知识图谱</span>
      <span class="mx-2 opacity-50">/</span>
      <span class="opacity-75">Built with Astro Islands</span>
    </div>

    <!-- Bottom-Right: Translucent Latest Dispatch Exhibition Plaque -->
    <a
      href={latestPostSlug ? `/journal/${latestPostSlug}` : '/journal'}
      class="group block w-full rounded-2xl border border-[var(--border)] bg-[var(--bg)]/75 p-4 backdrop-blur-md transition-all hover:border-[var(--text)] hover:bg-[var(--surface)]/90 md:w-80"
    >
      <div class="flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--text-muted)]">
        <span>Latest Dispatch</span>
        {latestPostDate && <span>{latestPostDate}</span>}
      </div>
      <div class="mt-1.5 truncate font-editorial text-sm font-medium text-[var(--text)]">
        {latestPostTitle ?? '日常随笔、图像与影音时间线'}
      </div>
      <div class="mt-2 flex items-center justify-between text-xs text-[var(--text-muted)]">
        <span>日常共 {journalCount} 篇</span>
        <span class="transition-transform group-hover:translate-x-0.5 group-hover:text-[var(--text)]">
          进入时间线 →
        </span>
      </div>
    </a>
  </div>
</section>

<script is:inline>
  (() => {
    const poster = document.getElementById('home-poster');
    if (!poster) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const layers = Array.from(poster.querySelectorAll('[data-parallax]'));
    if (!layers.length) return;

    let rafId = 0;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;

    const animate = () => {
      currentX += (targetX - currentX) * 0.08;
      currentY += (targetY - currentY) * 0.08;

      for (const layer of layers) {
        const depth = parseFloat(layer.getAttribute('data-parallax') || '0');
        const tx = (currentX * depth * 12).toFixed(2);
        const ty = (currentY * depth * 7).toFixed(2);
        layer.setAttribute('transform', `translate(${tx}, ${ty})`);
      }

      if (Math.abs(targetX - currentX) > 0.002 || Math.abs(targetY - currentY) > 0.002) {
        rafId = requestAnimationFrame(animate);
      } else {
        rafId = 0;
      }
    };

    poster.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const rect = poster.getBoundingClientRect();
      targetX = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
      targetY = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
      if (!rafId) rafId = requestAnimationFrame(animate);
    });

    poster.addEventListener('pointerleave', () => {
      targetX = 0;
      targetY = 0;
      if (!rafId) rafId = requestAnimationFrame(animate);
    });
  })();
</script>
