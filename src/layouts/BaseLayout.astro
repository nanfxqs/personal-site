---
import '@/styles/global.css';
import 'katex/dist/katex.min.css';
import { SITE } from '@/config/site';
import TopNav from '@/components/layout/TopNav.astro';
import { SearchCommand } from '@/components/layout/SearchCommand';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const { title, description = SITE.description, wide = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.nickname}` : SITE.title;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('nanf-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="relative flex min-h-screen flex-col overflow-x-clip">
    <!-- Subtle Morning Frost Sky Ambient Light Aura -->
    <div
      aria-hidden="true"
      class="ambient-sky-aura pointer-events-none fixed inset-x-0 top-0 -z-10 h-[34rem]"
    ></div>

    <TopNav />
    <main class:list={['page-content flex-1', wide ? 'w-full' : 'mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8']}>
      <slot />
    </main>
    <SearchCommand client:idle />

    <!-- Lightweight delegated Spotlight pointer tracker (desktop fine pointer only) -->
    <script is:inline>
      (() => {
        if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        let rafId = 0;
        let lastTarget = null;
        let clientX = 0;
        let clientY = 0;

        document.addEventListener(
          'pointermove',
          (e) => {
            if (e.pointerType !== 'mouse') return;
            const card = e.target instanceof Element ? e.target.closest('[data-spotlight]') : null;
            if (!card) return;
            lastTarget = card;
            clientX = e.clientX;
            clientY = e.clientY;
            if (rafId) return;
            rafId = requestAnimationFrame(() => {
              rafId = 0;
              if (!lastTarget) return;
              const rect = lastTarget.getBoundingClientRect();
              lastTarget.style.setProperty('--spot-x', `${clientX - rect.left}px`);
              lastTarget.style.setProperty('--spot-y', `${clientY - rect.top}px`);
            });
          },
          { passive: true },
        );
      })();
    </script>
  </body>
</html>
