---
import '@/styles/global.css';
import 'katex/dist/katex.min.css';
import { SITE } from '@/config/site';
import TopNav from '@/components/layout/TopNav.astro';
import SearchModal from '@/components/layout/SearchModal.astro';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  hideFooter?: boolean;
}

const { title, description = SITE.description, wide = false, hideFooter = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.nickname}` : SITE.title;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('nanf-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <TopNav />
    <main class:list={['flex-1', wide ? 'w-full' : 'mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8']}>
      <slot />
    </main>
    {!hideFooter && (
      <footer class="mt-20 border-t border-[var(--border)] py-8 text-center text-xs text-[var(--text-muted)]">
        <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-2 px-4 sm:flex-row sm:px-6">
          <p class="font-editorial">
            {SITE.nickname} · 日常随笔与考研知识图谱
          </p>
          <p>Built with Astro Islands · Static &amp; Self-Hosted</p>
        </div>
      </footer>
    )}
    <SearchModal />
  </body>
</html>
