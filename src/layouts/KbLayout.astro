---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import CourseSidebar from '@/components/kb/CourseSidebar.astro';
import RightRail from '@/components/kb/RightRail.astro';
import ReadingProgress from '@/components/kb/ReadingProgress.astro';
import type { ResolvedTopic } from '@/lib/kb-graph';

interface Props {
  topic: ResolvedTopic;
  headings?: MarkdownHeading[];
}

const { topic, headings = [] } = Astro.props;
---

<BaseLayout title={topic.title} description={topic.summary ?? `${topic.courseTitle} · ${topic.title}`} wide>
  <div class="mx-auto max-w-[1440px] px-4 py-6 sm:px-6 lg:px-8">
    <!-- Top Workbench Controls Bar -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-2 border-b border-[var(--border)] pb-4">
      <button
        type="button"
        id="toggle-left-tree"
        aria-expanded="true"
        class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)] px-3.5 py-1.5 text-xs font-medium text-[var(--text)] hover:border-[var(--text)] transition-colors cursor-pointer"
      >
        <span id="left-tree-icon">◧</span>
        <span>章节目录 · {topic.courseShortTitle}</span>
      </button>

      <button
        type="button"
        id="toggle-right-toc"
        aria-expanded="true"
        class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)] px-3.5 py-1.5 text-xs font-medium text-[var(--text)] hover:border-[var(--text)] transition-colors cursor-pointer"
      >
        <span>本页目录与关联</span>
        <span id="right-toc-icon">▾</span>
      </button>
    </div>

    <!-- Mobile collapsible syllabus -->
    <div
      id="mobile-left-tree"
      class="mb-6 hidden rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-4 lg:hidden"
    >
      <CourseSidebar
        subjectId={topic.subjectId}
        activeCourseId={topic.courseId}
        activeTopicId={topic.id}
      />
    </div>

    <!-- Push Sidebar + Smooth Layout Transition Workbench -->
    <div class="flex items-start">
      <!-- Left Sticky Push Sidebar (Independent Scroll) -->
      <aside
        id="push-left-sidebar"
        class="hidden lg:block shrink-0 sticky top-20 h-[calc(100vh-6.5rem)] w-64 mr-8 opacity-100 overflow-y-auto overflow-x-hidden pr-3 border-r border-[var(--border)] transition-all duration-300 ease-out"
      >
        <div class="w-60">
          <CourseSidebar
            subjectId={topic.subjectId}
            activeCourseId={topic.courseId}
            activeTopicId={topic.id}
          />
        </div>
      </aside>

      <!-- Main Reading & Interactive Canvas (smoothly expands when sidebars collapse) -->
      <article
        data-pagefind-body
        class="min-w-0 flex-1 transition-all duration-300 ease-out"
      >
        <div class="mx-auto max-w-3xl">
          <slot />
        </div>
      </article>

      <!-- Right Collapsible Push Sidebar: TOC & Cross-References -->
      <aside
        id="push-right-sidebar"
        class="hidden lg:block shrink-0 sticky top-20 h-[calc(100vh-6.5rem)] w-60 ml-8 opacity-100 overflow-y-auto overflow-x-hidden pl-3 border-l border-[var(--border)] transition-all duration-300 ease-out"
      >
        <div class="w-56">
          <RightRail topic={topic} headings={headings} />
        </div>
      </aside>
    </div>

    <!-- Mobile Right TOC fallback -->
    <div
      id="mobile-right-toc"
      class="mt-10 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5 lg:hidden"
    >
      <RightRail topic={topic} headings={headings} />
    </div>
  </div>

  <!-- Draggable Corner Monochrome Circular Reading Progress -->
  <ReadingProgress />
</BaseLayout>

<script is:inline>
  (() => {
    const leftBtn = document.getElementById('toggle-left-tree');
    const leftAside = document.getElementById('push-left-sidebar');
    const mobileLeft = document.getElementById('mobile-left-tree');

    const rightBtn = document.getElementById('toggle-right-toc');
    const rightAside = document.getElementById('push-right-sidebar');
    const rightIcon = document.getElementById('right-toc-icon');
    const mobileRight = document.getElementById('mobile-right-toc');

    let leftOpen = true;
    leftBtn?.addEventListener('click', () => {
      leftOpen = !leftOpen;
      leftBtn.setAttribute('aria-expanded', String(leftOpen));

      // Desktop push transition
      if (leftAside) {
        leftAside.classList.toggle('w-64', leftOpen);
        leftAside.classList.toggle('mr-8', leftOpen);
        leftAside.classList.toggle('opacity-100', leftOpen);
        leftAside.classList.toggle('pr-3', leftOpen);
        leftAside.classList.toggle('border-r', leftOpen);

        leftAside.classList.toggle('w-0', !leftOpen);
        leftAside.classList.toggle('mr-0', !leftOpen);
        leftAside.classList.toggle('opacity-0', !leftOpen);
        leftAside.classList.toggle('pr-0', !leftOpen);
        leftAside.classList.toggle('border-r-0', !leftOpen);
      }

      // Mobile toggle
      if (mobileLeft) {
        mobileLeft.classList.toggle('hidden', leftOpen);
      }
    });

    let rightOpen = true;
    rightBtn?.addEventListener('click', () => {
      rightOpen = !rightOpen;
      rightBtn.setAttribute('aria-expanded', String(rightOpen));
      if (rightIcon) rightIcon.textContent = rightOpen ? '▾' : '▸';

      if (rightAside) {
        rightAside.classList.toggle('w-60', rightOpen);
        rightAside.classList.toggle('ml-8', rightOpen);
        rightAside.classList.toggle('opacity-100', rightOpen);
        rightAside.classList.toggle('pl-3', rightOpen);
        rightAside.classList.toggle('border-l', rightOpen);

        rightAside.classList.toggle('w-0', !rightOpen);
        rightAside.classList.toggle('ml-0', !rightOpen);
        rightAside.classList.toggle('opacity-0', !rightOpen);
        rightAside.classList.toggle('pl-0', !rightOpen);
        rightAside.classList.toggle('border-l-0', !rightOpen);
      }

      if (mobileRight) {
        mobileRight.classList.toggle('hidden', !rightOpen);
      }
    });
  })();
</script>
