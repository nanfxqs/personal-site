---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import CourseSidebar from '@/components/kb/CourseSidebar.astro';
import RightRail from '@/components/kb/RightRail.astro';
import ReadingProgress from '@/components/kb/ReadingProgress.astro';
import type { ResolvedTopic } from '@/lib/kb-graph';

interface Props {
  topic: ResolvedTopic;
  headings?: MarkdownHeading[];
}

const { topic, headings = [] } = Astro.props;
---

<BaseLayout title={topic.title} description={topic.summary ?? `${topic.courseTitle} · ${topic.title}`} wide>
  <div class="relative mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Floating Controls Bar -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-2">
      <button
        type="button"
        id="toggle-left-tree"
        class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)]/90 px-3.5 py-1.5 text-xs font-medium text-[var(--text)] shadow-xs backdrop-blur-md hover:border-[var(--text)] transition-colors cursor-pointer"
      >
        <span>☰</span>
        <span>章节目录 · {topic.courseShortTitle}</span>
      </button>

      <button
        type="button"
        id="toggle-right-toc"
        class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)]/90 px-3.5 py-1.5 text-xs font-medium text-[var(--text)] shadow-xs backdrop-blur-md hover:border-[var(--text)] transition-colors cursor-pointer"
      >
        <span>本页目录与关联</span>
        <span id="right-toc-icon">▾</span>
      </button>
    </div>

    <!-- Floating Collapsible Left Multi-Level Tree Drawer -->
    <div
      id="floating-left-tree"
      class="fixed top-24 left-4 z-40 hidden max-h-[calc(100vh-8rem)] w-72 overflow-y-auto rounded-2xl border border-[var(--border)] bg-[var(--surface)]/95 p-5 shadow-2xl backdrop-blur-md sm:left-6"
    >
      <div class="mb-4 flex items-center justify-between border-b border-[var(--border)] pb-2.5">
        <span class="text-xs font-semibold tracking-wider uppercase text-[var(--text-muted)]">
          知识库导航树
        </span>
        <button
          type="button"
          id="close-left-tree"
          class="rounded-md px-2 py-0.5 text-xs text-[var(--text-muted)] hover:text-[var(--text)] cursor-pointer"
        >
          收起 ✕
        </button>
      </div>
      <CourseSidebar
        subjectId={topic.subjectId}
        activeCourseId={topic.courseId}
        activeTopicId={topic.id}
      />
    </div>

    <!-- Main Workbench Grid -->
    <div id="kb-grid" class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_240px]">
      <!-- Main Reading & Interactive Canvas -->
      <article data-pagefind-body class="min-w-0">
        <slot />
      </article>

      <!-- Collapsible Right Rail: TOC & Cross-References -->
      <div id="collapsible-right-toc" class="lg:block">
        <div class="sticky top-22 max-h-[calc(100vh-7rem)] overflow-y-auto rounded-2xl border border-[var(--border)] bg-[var(--surface)]/70 p-4 lg:border-0 lg:bg-transparent lg:p-0 lg:pl-2">
          <RightRail topic={topic} headings={headings} />
        </div>
      </div>
    </div>
  </div>

  <!-- Corner Monochrome Gradient Circular Reading Progress -->
  <ReadingProgress />
</BaseLayout>

<script is:inline>
  (() => {
    const leftBtn = document.getElementById('toggle-left-tree');
    const closeLeftBtn = document.getElementById('close-left-tree');
    const leftDrawer = document.getElementById('floating-left-tree');

    const rightBtn = document.getElementById('toggle-right-toc');
    const rightPanel = document.getElementById('collapsible-right-toc');
    const rightIcon = document.getElementById('right-toc-icon');
    const kbGrid = document.getElementById('kb-grid');

    function setLeftOpen(open) {
      if (!leftDrawer) return;
      leftDrawer.classList.toggle('hidden', !open);
    }

    leftBtn?.addEventListener('click', () => {
      if (!leftDrawer) return;
      setLeftOpen(leftDrawer.classList.contains('hidden'));
    });

    closeLeftBtn?.addEventListener('click', () => setLeftOpen(false));

    // Close floating drawer when clicking outside
    document.addEventListener('click', (e) => {
      if (!leftDrawer || leftDrawer.classList.contains('hidden')) return;
      const target = e.target;
      if (
        target instanceof Node &&
        !leftDrawer.contains(target) &&
        !leftBtn?.contains(target)
      ) {
        setLeftOpen(false);
      }
    });

    let rightCollapsed = false;
    rightBtn?.addEventListener('click', () => {
      rightCollapsed = !rightCollapsed;
      if (rightPanel) {
        rightPanel.classList.toggle('hidden', rightCollapsed);
        rightPanel.classList.toggle('lg:block', !rightCollapsed);
      }
      if (kbGrid) {
        kbGrid.classList.toggle('lg:grid-cols-[minmax(0,1fr)_240px]', !rightCollapsed);
        kbGrid.classList.toggle('lg:grid-cols-1', rightCollapsed);
      }
      if (rightIcon) {
        rightIcon.textContent = rightCollapsed ? '▸' : '▾';
      }
    });
  })();
</script>
