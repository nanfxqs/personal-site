---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import CourseSidebar from '@/components/kb/CourseSidebar.astro';
import RightRail from '@/components/kb/RightRail.astro';
import ReadingProgress from '@/components/kb/ReadingProgress.astro';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import type { ResolvedTopic } from '@/lib/kb-graph';

interface Props {
  topic: ResolvedTopic;
  headings?: MarkdownHeading[];
}

const { topic, headings = [] } = Astro.props;
---

<BaseLayout title={topic.title} description={topic.summary ?? `${topic.courseTitle} · ${topic.title}`} wide>
  <div class="mx-auto max-w-[1440px] px-4 pt-4 pb-16 sm:px-6 lg:px-8 lg:pb-0">
    <!-- Floating Sticky Directory Toggle Controls (always accessible while scrolling) -->
    <div
      class="pointer-events-none sticky top-[4.5rem] z-30 mb-5 flex items-center justify-between gap-2"
    >
      <button
        type="button"
        id="toggle-left-tree"
        aria-expanded="true"
        aria-controls="push-left-sidebar"
        title="展开或折叠章节目录"
        class={cn(
          buttonVariants({ variant: 'outline', size: 'sm' }),
          'pointer-events-auto rounded-full bg-card/90 px-3.5 shadow-md backdrop-blur-md hover:shadow-lg',
        )}
      >
        <svg
          id="left-tree-icon"
          class="h-3.5 w-3.5 shrink-0 text-muted-foreground transition-transform duration-200"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="18" height="18" x="3" y="3" rx="2" />
          <path d="M9 3v18" />
        </svg>
        <span id="left-tree-label" class="whitespace-nowrap">
          章节目录 <span class="hidden sm:inline text-muted-foreground">· {topic.courseShortTitle}</span>
        </span>
      </button>

      <button
        type="button"
        id="toggle-right-toc"
        aria-expanded="true"
        aria-controls="push-right-sidebar"
        title="展开或折叠本页目录与关联"
        class={cn(
          buttonVariants({ variant: 'outline', size: 'sm' }),
          'pointer-events-auto rounded-full bg-card/90 px-3.5 shadow-md backdrop-blur-md hover:shadow-lg',
        )}
      >
        <span id="right-toc-label" class="whitespace-nowrap">本页目录与关联</span>
        <svg
          id="right-toc-icon"
          class="h-3.5 w-3.5 shrink-0 text-muted-foreground transition-transform duration-200"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="18" height="18" x="3" y="3" rx="2" />
          <path d="M15 3v18" />
        </svg>
      </button>
    </div>

    <!-- Mobile Floating Left Drawer (< lg) -->
    <dialog
      id="mobile-left-drawer"
      class="kb-mobile-drawer lg:hidden"
      aria-label="章节目录"
    >
      <div
        data-close-drawer="left"
        class="absolute inset-0 bg-black/35 backdrop-blur-xs"
      ></div>
      <div
        class="relative z-10 flex h-full min-h-0 w-[min(84vw,20rem)] flex-col border-r border-[var(--border)] bg-[var(--bg)] shadow-2xl"
      >
        <div class="flex shrink-0 items-center justify-between border-b border-[var(--border)] px-4 py-3.5">
          <span class="text-xs font-semibold tracking-wider text-[var(--text)]">
            章节目录 · {topic.courseShortTitle}
          </span>
          <button
            type="button"
            data-close-drawer="left"
            aria-label="关闭章节目录"
            class="flex h-7 w-7 items-center justify-center rounded-full border border-[var(--border)] text-xs text-[var(--text-muted)] hover:border-[var(--text)] hover:text-[var(--text)] cursor-pointer"
          >
            ✕
          </button>
        </div>
        <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain p-4">
          <CourseSidebar
            subjectId={topic.subjectId}
            activeCourseId={topic.courseId}
            activeTopicId={topic.id}
          />
        </div>
      </div>
    </dialog>

    <!-- Mobile Floating Right Drawer (< lg) -->
    <dialog
      id="mobile-right-drawer"
      class="kb-mobile-drawer lg:hidden"
      aria-label="本页目录与关联"
    >
      <div
        data-close-drawer="right"
        class="absolute inset-0 bg-black/35 backdrop-blur-xs"
      ></div>
      <div
        class="relative z-10 ml-auto flex h-full min-h-0 w-[min(84vw,20rem)] flex-col border-l border-[var(--border)] bg-[var(--bg)] shadow-2xl"
      >
        <div class="flex shrink-0 items-center justify-between border-b border-[var(--border)] px-4 py-3.5">
          <span class="text-xs font-semibold tracking-wider text-[var(--text)]">
            本页目录与关联
          </span>
          <button
            type="button"
            data-close-drawer="right"
            aria-label="关闭本页目录"
            class="flex h-7 w-7 items-center justify-center rounded-full border border-[var(--border)] text-xs text-[var(--text-muted)] hover:border-[var(--text)] hover:text-[var(--text)] cursor-pointer"
          >
            ✕
          </button>
        </div>
        <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain p-4">
          <RightRail topic={topic} headings={headings} />
        </div>
      </div>
    </dialog>

    <!-- Push Sidebar + Smooth Layout Transition Workbench -->
    <div class="flex items-start">
      <!-- Left Sticky Push Sidebar (Independent Scroll, clears floating toggle pill) -->
      <aside
        id="push-left-sidebar"
        aria-label="学科章节"
        class="hidden lg:block shrink-0 sticky top-[7.5rem] h-[calc(100vh-8.5rem)] w-64 mr-8 opacity-100 overflow-y-auto overflow-x-hidden pr-3 border-r border-border transition-[width,margin,opacity,padding] duration-250 ease-[var(--ease-out)]"
      >
        <div class="w-60 pb-6">
          <CourseSidebar
            subjectId={topic.subjectId}
            activeCourseId={topic.courseId}
            activeTopicId={topic.id}
          />
        </div>
      </aside>

      <!-- Main Reading & Interactive Canvas (smoothly expands when sidebars collapse) -->
      <article
        data-pagefind-body
        data-reading-progress-anchor
        class="min-w-0 flex-1 lg:pb-16"
      >
        <div class="mx-auto max-w-3xl">
          <slot />
        </div>
      </article>

      <!-- Right Collapsible Push Sidebar: TOC & Cross-References -->
      <aside
        id="push-right-sidebar"
        aria-label="本页目录与关联"
        class="hidden lg:block shrink-0 sticky top-[7.5rem] h-[calc(100vh-8.5rem)] w-60 ml-8 opacity-100 overflow-y-auto overflow-x-hidden pl-3 border-l border-border transition-[width,margin,opacity,padding] duration-250 ease-[var(--ease-out)]"
      >
        <div class="w-56 pb-6">
          <RightRail topic={topic} headings={headings} />
        </div>
      </aside>
    </div>
  </div>

  <!-- Draggable Corner Monochrome Circular Reading Progress -->
  <ReadingProgress />
</BaseLayout>

<style>
  .kb-mobile-drawer {
    --drawer-top: calc(3.75rem + 1px);
    position: fixed;
    inset: var(--drawer-top) 0 auto;
    width: 100%;
    max-width: none;
    height: calc(100dvh - var(--drawer-top));
    max-height: none;
    margin: 0;
    overflow: hidden;
    background: transparent;
  }

  .kb-mobile-drawer::backdrop {
    background: transparent;
  }

  :global(html:has(.kb-mobile-drawer[open])) {
    overflow: hidden;
  }
</style>

<script is:inline>
  (() => {
    const leftBtn = document.getElementById('toggle-left-tree');
    const leftAside = document.getElementById('push-left-sidebar');
    const leftDrawer = document.getElementById('mobile-left-drawer');

    const rightBtn = document.getElementById('toggle-right-toc');
    const rightAside = document.getElementById('push-right-sidebar');
    const rightDrawer = document.getElementById('mobile-right-drawer');

    const desktopMedia = window.matchMedia('(min-width: 1024px)');
    let desktopLeftOpen = true;
    let desktopRightOpen = true;

    function syncDesktopLeft() {
      if (!leftAside || !leftBtn) return;
      leftBtn.setAttribute('aria-expanded', String(desktopLeftOpen));
      leftAside.inert = !desktopLeftOpen;
      leftBtn.classList.toggle('opacity-90', !desktopLeftOpen);

      leftAside.classList.toggle('w-64', desktopLeftOpen);
      leftAside.classList.toggle('mr-8', desktopLeftOpen);
      leftAside.classList.toggle('opacity-100', desktopLeftOpen);
      leftAside.classList.toggle('pr-3', desktopLeftOpen);
      leftAside.classList.toggle('border-r', desktopLeftOpen);

      leftAside.classList.toggle('w-0', !desktopLeftOpen);
      leftAside.classList.toggle('mr-0', !desktopLeftOpen);
      leftAside.classList.toggle('opacity-0', !desktopLeftOpen);
      leftAside.classList.toggle('pr-0', !desktopLeftOpen);
      leftAside.classList.toggle('border-r-0', !desktopLeftOpen);
    }

    function syncDesktopRight() {
      if (!rightAside || !rightBtn) return;
      rightBtn.setAttribute('aria-expanded', String(desktopRightOpen));
      rightAside.inert = !desktopRightOpen;
      rightBtn.classList.toggle('opacity-90', !desktopRightOpen);

      rightAside.classList.toggle('w-60', desktopRightOpen);
      rightAside.classList.toggle('ml-8', desktopRightOpen);
      rightAside.classList.toggle('opacity-100', desktopRightOpen);
      rightAside.classList.toggle('pl-3', desktopRightOpen);
      rightAside.classList.toggle('border-l', desktopRightOpen);

      rightAside.classList.toggle('w-0', !desktopRightOpen);
      rightAside.classList.toggle('ml-0', !desktopRightOpen);
      rightAside.classList.toggle('opacity-0', !desktopRightOpen);
      rightAside.classList.toggle('pl-0', !desktopRightOpen);
      rightAside.classList.toggle('border-l-0', !desktopRightOpen);
    }

    function setMobileDrawer(side, open) {
      const drawer = side === 'left' ? leftDrawer : rightDrawer;
      const otherDrawer = side === 'left' ? rightDrawer : leftDrawer;
      if (open && !desktopMedia.matches && drawer && !drawer.open) {
        otherDrawer?.close();
        drawer.showModal();
      } else if (!open && drawer?.open) {
        drawer.close();
      }
      syncMobileControls();
    }

    function syncMobileControls() {
      if (desktopMedia.matches) return;
      leftBtn?.setAttribute('aria-controls', 'mobile-left-drawer');
      rightBtn?.setAttribute('aria-controls', 'mobile-right-drawer');
      leftBtn?.setAttribute('aria-expanded', String(Boolean(leftDrawer?.open)));
      rightBtn?.setAttribute('aria-expanded', String(Boolean(rightDrawer?.open)));
    }

    leftDrawer?.addEventListener('close', syncMobileControls);
    rightDrawer?.addEventListener('close', syncMobileControls);
    syncMobileControls();

    leftBtn?.addEventListener('click', () => {
      if (desktopMedia.matches) {
        desktopLeftOpen = !desktopLeftOpen;
        syncDesktopLeft();
      } else {
        setMobileDrawer('left', !leftDrawer?.open);
      }
    });

    rightBtn?.addEventListener('click', () => {
      if (desktopMedia.matches) {
        desktopRightOpen = !desktopRightOpen;
        syncDesktopRight();
      } else {
        setMobileDrawer('right', !rightDrawer?.open);
      }
    });

    document.querySelectorAll('[data-close-drawer]').forEach((el) => {
      el.addEventListener('click', () => {
        const side = el.getAttribute('data-close-drawer');
        if (side === 'left' || side === 'right') {
          setMobileDrawer(side, false);
        }
      });
    });

    // Close mobile right TOC drawer when clicking an in-page heading link
    rightDrawer?.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', () => setMobileDrawer('right', false));
    });

    desktopMedia.addEventListener('change', (e) => {
      if (e.matches) {
        setMobileDrawer('left', false);
        setMobileDrawer('right', false);
        leftBtn?.setAttribute('aria-controls', 'push-left-sidebar');
        rightBtn?.setAttribute('aria-controls', 'push-right-sidebar');
        syncDesktopLeft();
        syncDesktopRight();
      } else {
        syncMobileControls();
      }
    });
  })();
</script>
